class ReleaseValidationError(ValueError):
    """The supplied release lock cannot be used even for a dry-run plan."""


class ApplyBlockedError(ReleaseValidationError):
    """Evidence or operator controls are missing for a state-changing apply."""


def fail(path: str, message: str) -> None:
    raise ReleaseValidationError(f"{path}: {message}")


def require_object(value: Any, path: str) -> dict[str, Any]:
    if type(value) is not dict:
        fail(path, "must be an object")
    return value


def require_keys(
    value: Any,
    path: str,
    required: Iterable[str],
    optional: Iterable[str] = (),
) -> dict[str, Any]:
    obj = require_object(value, path)
    required_set = set(required)
    allowed_set = required_set | set(optional)
    missing = sorted(required_set - set(obj))
    unexpected = sorted(set(obj) - allowed_set)
    if missing:
        fail(path, f"missing required field(s): {', '.join(missing)}")
    if unexpected:
        fail(path, f"unsupported field(s): {', '.join(unexpected)}")
    return obj


def require_string(value: Any, path: str) -> str:
    if type(value) is not str or not value.strip():
        fail(path, "must be a non-empty string")
    return value


def require_integer(value: Any, path: str, minimum: int = 0) -> int:
    if type(value) is not int or value < minimum:
        fail(path, f"must be an integer greater than or equal to {minimum}")
    if value > 9007199254740991:
        fail(path, "exceeds the interoperable JSON integer range")
    return value


def require_boolean(value: Any, path: str) -> bool:
    if type(value) is not bool:
        fail(path, "must be a boolean")
    return value


def require_identifier(value: Any, path: str) -> str:
    text = require_string(value, path)
    if not IDENTIFIER_RE.fullmatch(text):
        fail(path, "must use lowercase letters, digits, dots, underscores, or hyphens")
    return text


def require_digest(value: Any, path: str) -> str:
    text = require_string(value, path)
    if not SHA256_RE.fullmatch(text):
        fail(path, "must be a lowercase sha256:<64-hex> digest")
    return text


def require_git_commit(value: Any, path: str) -> str:
    text = require_string(value, path)
    if not GIT_COMMIT_RE.fullmatch(text):
        fail(path, "must be a 40- or 64-character lowercase Git object ID")
    return text


def require_image(value: Any, path: str, *, require_oci_scheme: bool = False) -> str:
    text = require_string(value, path)
    if not IMAGE_RE.fullmatch(text):
        fail(path, "must be an image pinned by @sha256:<64-hex>; mutable tags are not accepted")
    if require_oci_scheme and not text.startswith("oci://"):
        fail(path, "must use an oci:// URI pinned by digest")
    reference = text.removeprefix("oci://").rsplit("@", 1)[0]
    last_segment = reference.rsplit("/", 1)[-1]
    if ":" in last_segment:
        fail(path, "must not carry a tag alongside the digest")
    return text


def parse_rfc3339(value: Any, path: str) -> dt.datetime:
    text = require_string(value, path)
    try:
        parsed = dt.datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        fail(path, "must be an RFC 3339 timestamp")
    if parsed.tzinfo is None:
        fail(path, "must include a timezone")
    return parsed.astimezone(dt.timezone.utc)


def parse_timestamp(value: Any, path: str) -> str:
    text = require_string(value, path)
    parsed = parse_rfc3339(text, path)
    if parsed.astimezone(dt.timezone.utc) <= dt.datetime.now(dt.timezone.utc):
        fail(path, "is expired")
    return text


def reject_sensitive_field_names(value: Any, path: str = "$") -> None:
    if type(value) is dict:
        for key, child in value.items():
            lower_key = key.lower()
            if any(marker in lower_key for marker in SENSITIVE_FIELD_MARKERS):
                fail(f"{path}.{key}", "release locks must not contain secret-bearing fields")
            reject_sensitive_field_names(child, f"{path}.{key}")
    elif type(value) is list:
        for index, child in enumerate(value):
            reject_sensitive_field_names(child, f"{path}[{index}]")


def read_release(path_text: str) -> tuple[dict[str, Any], bytes]:
    path = Path(path_text)
    raw = read_regular_file_bytes(path, str(path), MAX_RELEASE_BYTES)

    def unique_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in pairs:
            if key in result:
                raise ReleaseValidationError(f"{path}: duplicate JSON field: {key}")
            result[key] = value
        return result

    try:
        data = json.loads(
            raw.decode("utf-8"),
            object_pairs_hook=unique_object,
            parse_constant=lambda value: (_ for _ in ()).throw(ValueError(f"non-finite JSON value: {value}")),
        )
    except (UnicodeDecodeError, ValueError, json.JSONDecodeError) as error:
        raise ReleaseValidationError(f"{path}: invalid release lock JSON: {error}") from error
    return require_object(data, "$"), raw


def validate_release(release: dict[str, Any]) -> dict[str, Any]:
    reject_sensitive_field_names(release)
    root = require_keys(
        release,
        "$",
        (
            "schema",
            "schemaVersion",
            "releaseId",
            "sequence",
            "network",
            "authorization",
            "source",
            "services",
            "policy",
            "migration",
        ),
    )
    if root["schema"] == RELEASE_SCHEMA_V1 and root["schemaVersion"] == 1:
        release_schema_version = 1
    elif root["schema"] == RELEASE_SCHEMA_V2 and root["schemaVersion"] == 2:
        release_schema_version = 2
    elif root["schema"] == RELEASE_SCHEMA_V3 and root["schemaVersion"] == 3:
        release_schema_version = 3
    else:
        fail(
            "$.schema",
            f"must be {RELEASE_SCHEMA_V1!r} with schemaVersion 1 or {RELEASE_SCHEMA_V2!r} with schemaVersion 2",
        )
    release_id = require_identifier(root["releaseId"], "$.releaseId")
    sequence = require_integer(root["sequence"], "$.sequence", 1)

    network = require_keys(root["network"], "$.network", ("id", "plane"))
    network_id = require_identifier(network["id"], "$.network.id")
    if network["plane"] != "bank":
        fail("$.network.plane", "must equal 'bank' for this Cell rollout controller")

    authorization = require_keys(
        root["authorization"],
        "$.authorization",
        ("tuf", "bft", "vaultCompatibility"),
    )
    tuf_required = ("targetPath",) if release_schema_version >= 2 else (
        "targetPath",
        "metadataVersion",
        "targetDigest",
        "expiresAt",
    )
    tuf = require_keys(authorization["tuf"], "$.authorization.tuf", tuf_required)
    target_path = require_string(tuf["targetPath"], "$.authorization.tuf.targetPath")
    if target_path.startswith("/") or ".." in Path(target_path).parts:
        fail("$.authorization.tuf.targetPath", "must be a relative, traversal-free path")
    if target_path != f"releases/{release_id}.json":
        fail("$.authorization.tuf.targetPath", "must identify this exact release under releases/")
    tuf_summary: dict[str, Any] = {"targetPath": target_path}
    if release_schema_version == 1:
        tuf_summary.update(
            {
                "metadataVersion": require_integer(tuf["metadataVersion"], "$.authorization.tuf.metadataVersion", 1),
                "targetDigest": require_digest(tuf["targetDigest"], "$.authorization.tuf.targetDigest"),
                "expiresAt": parse_timestamp(tuf["expiresAt"], "$.authorization.tuf.expiresAt"),
            }
        )

    bft = require_keys(
        authorization["bft"],
        "$.authorization.bft",
        ("networkId", "epoch", "threshold", "members") if release_schema_version == 3 else ("networkId", "height", "commitDigest", "threshold", "members"),
    )
    bft_network_id = require_identifier(bft["networkId"], "$.authorization.bft.networkId")
    bft_height = require_integer(bft["height"], "$.authorization.bft.height", 1) if release_schema_version < 3 else None
    bft_commit = require_digest(bft["commitDigest"], "$.authorization.bft.commitDigest") if release_schema_version < 3 else None
    bft_epoch = require_integer(bft["epoch"], "$.authorization.bft.epoch", 1) if release_schema_version == 3 else None
    bft_threshold = require_integer(bft["threshold"], "$.authorization.bft.threshold", 1)
    bft_members = require_integer(bft["members"], "$.authorization.bft.members", 4)
    if release_schema_version == 3 and (bft_members != 4 or bft_threshold != 3):
        fail("$.authorization.bft", "v3 currently supports only static four-member, three-authorizer governance")
    minimum_bft_threshold = (2 * bft_members) // 3 + 1
    if bft_threshold < minimum_bft_threshold or bft_threshold > bft_members:
        fail(
            "$.authorization.bft.threshold",
            f"must be between {minimum_bft_threshold} and {bft_members} for the declared BFT membership",
        )

    vault = require_keys(
        authorization["vaultCompatibility"],
        "$.authorization.vaultCompatibility",
        ("threshold", "members", "attestationDigest"),
    )
    vault_threshold = require_integer(vault["threshold"], "$.authorization.vaultCompatibility.threshold", 2)
    vault_members = require_integer(vault["members"], "$.authorization.vaultCompatibility.members", 3)
    vault_attestation = require_digest(
        vault["attestationDigest"],
        "$.authorization.vaultCompatibility.attestationDigest",
    )
    if vault_threshold > vault_members:
        fail("$.authorization.vaultCompatibility.threshold", "cannot exceed Vault membership")

    source = require_keys(root["source"], "$.source", ("bundle", "repositories"))
    bundle = require_keys(source["bundle"], "$.source.bundle", ("uri", "digest"))
    bundle_uri = require_image(bundle["uri"], "$.source.bundle.uri", require_oci_scheme=True)
    bundle_digest = require_digest(bundle["digest"], "$.source.bundle.digest")
    if not bundle_uri.endswith(f"@{bundle_digest}"):
        fail("$.source.bundle.uri", "must end with the declared source.bundle.digest")

    repositories = require_keys(source["repositories"], "$.source.repositories", REPOSITORIES)
    repository_summary: dict[str, str] = {}
    for name in REPOSITORIES:
        repository = require_keys(
            repositories[name],
            f"$.source.repositories.{name}",
            ("commit", "bundleDigest"),
        )
        repository_summary[name] = require_git_commit(
            repository["commit"], f"$.source.repositories.{name}.commit"
        )
        require_digest(repository["bundleDigest"], f"$.source.repositories.{name}.bundleDigest")

    services = require_keys(root["services"], "$.services", SERVICE_REPOSITORY)
    service_summary: dict[str, dict[str, str]] = {}
    for name, expected_repository in SERVICE_REPOSITORY.items():
        service = require_keys(
            services[name],
            f"$.services.{name}",
            ("image", "configDigest", "repository", "rollout"),
        )
        image = require_image(service["image"], f"$.services.{name}.image")
        config_digest = require_digest(service["configDigest"], f"$.services.{name}.configDigest")
        if service["repository"] != expected_repository:
            fail(f"$.services.{name}.repository", f"must equal {expected_repository!r}")
        if service["rollout"] != SERVICE_ROLLOUT[name]:
            fail(f"$.services.{name}.rollout", f"must equal {SERVICE_ROLLOUT[name]!r}")
        service_summary[name] = {"image": image, "configDigest": config_digest}

    policy = require_keys(
        root["policy"],
        "$.policy",
        ("allowSourceBuild", "vaultSignerActivation", "minimumBankObservers"),
    )
    if require_boolean(policy["allowSourceBuild"], "$.policy.allowSourceBuild"):
        fail("$.policy.allowSourceBuild", "must be false; releases must use pre-built immutable artifacts")
    if require_boolean(policy["vaultSignerActivation"], "$.policy.vaultSignerActivation"):
        fail("$.policy.vaultSignerActivation", "must be false; deploy automation may not activate Vault signers")
    bank_observers = require_integer(policy["minimumBankObservers"], "$.policy.minimumBankObservers", bft_threshold)
    if bank_observers > bft_members:
        fail("$.policy.minimumBankObservers", "cannot exceed the declared BFT membership")

    migration = require_keys(
        root["migration"],
        "$.migration",
        ("id", "classification", "snapshotRequired", "recoveryEvidenceDigest"),
    )
    migration_id = require_identifier(migration["id"], "$.migration.id")
    if migration["classification"] not in ("reversible", "approved-recovery"):
        fail("$.migration.classification", "must be 'reversible' or 'approved-recovery'")
    if not require_boolean(migration["snapshotRequired"], "$.migration.snapshotRequired"):
        fail("$.migration.snapshotRequired", "must be true for a Cell update")
    recovery_digest = require_digest(migration["recoveryEvidenceDigest"], "$.migration.recoveryEvidenceDigest")

    return {
        "releaseSchemaVersion": release_schema_version,
        "releaseId": release_id,
        "sequence": sequence,
        "networkId": network_id,
        "tuf": tuf_summary,
        "bft": {
            "networkId": bft_network_id,
            "height": bft_height,
            "commitDigest": bft_commit,
            "epoch": bft_epoch,
            "threshold": bft_threshold,
            "members": bft_members,
        },
        "vaultCompatibility": {
            "threshold": vault_threshold,
            "members": vault_members,
            "attestationDigest": vault_attestation,
        },
        "sourceBundle": {"uri": bundle_uri, "digest": bundle_digest},
        "repositories": repository_summary,
        "services": service_summary,
        "policy": {"minimumBankObservers": bank_observers},
        "migration": {
            "id": migration_id,
            "classification": migration["classification"],
            "recoveryEvidenceDigest": recovery_digest,
        },
    }


def canonical_digest(value: Any) -> str:
    return "sha256:" + hashlib.sha256(canonical_bytes(value)).hexdigest()


def canonical_bytes(value: Any) -> bytes:
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")


def read_regular_file_bytes(path: Path, label: str, maximum_bytes: int) -> bytes:
    """Read a bounded regular file without following its final symlink.

    Release locks, signed evidence, and trust state are security inputs. A
    check followed by Path.read_bytes() is vulnerable to a replacement between
    the check and the read, so keep one no-follow descriptor open throughout.
    """
    flags = os.O_RDONLY
    # Opening a FIFO must not hang before fstat can reject it.
    flags |= getattr(os, "O_NONBLOCK", 0)
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        fail(label, f"must be a readable regular file: {error}")
    try:
        with os.fdopen(descriptor, "rb", closefd=True) as handle:
            metadata = os.fstat(handle.fileno())
            if not stat_module.S_ISREG(metadata.st_mode):
                fail(label, "must be a regular file")
            if metadata.st_size > maximum_bytes:
                fail(label, f"document exceeds {maximum_bytes} bytes")
            raw = handle.read(maximum_bytes + 1)
    except ReleaseValidationError:
        raise
    except OSError as error:
        fail(label, f"cannot read regular file: {error}")
    if len(raw) > maximum_bytes:
        fail(label, f"document exceeds {maximum_bytes} bytes")
    return raw


def read_json_document(path_text: str, label: str, maximum_bytes: int = MAX_EVIDENCE_BYTES) -> dict[str, Any]:
    path = Path(path_text)
    try:
        raw = read_regular_file_bytes(path, label, maximum_bytes)

        def unique_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
            result: dict[str, Any] = {}
            for key, value in pairs:
                if key in result:
                    fail(label, f"duplicate JSON field: {key}")
                result[key] = value
            return result

        def invalid_constant(value: str) -> None:
            raise ValueError(f"non-finite JSON value: {value}")

        document = json.loads(
            raw.decode("utf-8"),
            object_pairs_hook=unique_object,
            parse_constant=invalid_constant,
        )
        return require_object(document, label)
    except ReleaseValidationError:
        raise
    except (UnicodeDecodeError, ValueError, json.JSONDecodeError) as error:
        fail(label, f"invalid JSON document: {error}")


def read_tuf_metadata_file(metadata_dir: Path, filename: str) -> tuple[bytes, dict[str, Any]]:
    """Read one local TUF metadata file without following a symlink.

    The Cell controller consumes a complete, operator-provided metadata bundle
    offline.  Metadata is security evidence: reject links, duplicate JSON keys
    and oversized documents before looking at a signature.
    """
    if filename.startswith("/") or ".." in Path(filename).parts or "/" in filename:
        fail("TUF metadata", f"unsafe metadata filename: {filename!r}")
    path = metadata_dir / filename
    try:
        raw = read_regular_file_bytes(path, f"TUF metadata {filename}", MAX_TUF_METADATA_BYTES)
        text = raw.decode("utf-8")

        def unique_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
            result: dict[str, Any] = {}
            for key, value in pairs:
                if key in result:
                    fail(f"TUF metadata {filename}", f"duplicate JSON field: {key}")
                result[key] = value
            return result

        def invalid_constant(value: str) -> None:
            raise ValueError(f"non-finite JSON value: {value}")

        document = json.loads(
            text,
            object_pairs_hook=unique_object,
            parse_constant=invalid_constant,
        )
    except ReleaseValidationError:
        raise
    except (UnicodeDecodeError, ValueError, json.JSONDecodeError) as error:
        fail("TUF metadata", f"invalid {filename}: {error}")
    return raw, require_object(document, f"TUF metadata {filename}")


def require_tuf_keyid(value: Any, path: str) -> str:
    keyid = require_string(value, path)
    if not TUF_KEYID_RE.fullmatch(keyid):
        fail(path, "must be a lowercase 64-character SHA-256 key ID")
    return keyid


def parse_tuf_key(value: Any, keyid: str, path: str) -> bytes:
    """Validate an interoperable TUF Ed25519 key and return SPKI DER bytes."""
    key = require_keys(value, path, ("keytype", "scheme", "keyval"))
    if key["keytype"] != "ed25519" or key["scheme"] != "ed25519":
        fail(path, "only standard TUF ed25519 keys are supported")
    keyval = require_keys(key["keyval"], f"{path}.keyval", ("public",))
    raw_hex = require_string(keyval["public"], f"{path}.keyval.public")
    if not re.fullmatch(r"[0-9a-f]{64}", raw_hex):
        fail(f"{path}.keyval.public", "must be a lowercase 32-byte Ed25519 public key in hex")
    expected_keyid = hashlib.sha256(canonical_bytes(key)).hexdigest()
    if keyid != expected_keyid:
        fail(path, "key ID does not match the canonical TUF key object")
    return TUF_ED25519_SPKI_PREFIX + bytes.fromhex(raw_hex)


def parse_tuf_keys(value: Any, path: str) -> dict[str, bytes]:
    keys = require_object(value, path)
    if not keys:
        fail(path, "must contain at least one trusted key")
    parsed: dict[str, bytes] = {}
    for keyid, key in keys.items():
        parsed_keyid = require_tuf_keyid(keyid, f"{path}.<keyid>")
        parsed[parsed_keyid] = parse_tuf_key(key, parsed_keyid, f"{path}.{parsed_keyid}")
    return parsed


def parse_tuf_role(value: Any, path: str, keys: dict[str, bytes]) -> tuple[tuple[str, ...], int]:
    role = require_keys(value, path, ("keyids", "threshold"))
    if type(role["keyids"]) is not list or not role["keyids"]:
        fail(f"{path}.keyids", "must be a non-empty array")
    keyids: list[str] = []
    for index, value in enumerate(role["keyids"]):
        keyid = require_tuf_keyid(value, f"{path}.keyids[{index}]")
        if keyid in keyids:
            fail(f"{path}.keyids[{index}]", "duplicate key ID")
        if keyid not in keys:
            fail(f"{path}.keyids[{index}]", "does not exist in the delegated key set")
        keyids.append(keyid)
    threshold = require_integer(role["threshold"], f"{path}.threshold", 1)
    if threshold > len(keyids):
        fail(f"{path}.threshold", "cannot exceed the number of role keys")
    return tuple(keyids), threshold


def parse_tuf_signed_document(document: dict[str, Any], path: str, expected_type: str) -> tuple[dict[str, Any], list[Any]]:
    root = require_keys(document, path, ("signed", "signatures"))
    signed = require_object(root["signed"], f"{path}.signed")
    if signed.get("_type") != expected_type:
        fail(f"{path}.signed._type", f"must equal {expected_type!r}")
    spec_version = require_string(signed.get("spec_version"), f"{path}.signed.spec_version")
    if not re.fullmatch(r"1\.[0-9]+\.[0-9]+", spec_version):
        fail(f"{path}.signed.spec_version", "must be a supported TUF 1.x version")
    require_integer(signed.get("version"), f"{path}.signed.version", 1)
    parse_timestamp(signed.get("expires"), f"{path}.signed.expires")
    if type(root["signatures"]) is not list:
        fail(f"{path}.signatures", "must be an array")
    return signed, root["signatures"]


def valid_tuf_signature_keyids(
    document: dict[str, Any],
    role_keyids: Iterable[str],
    keys: dict[str, bytes],
    path: str,
) -> set[str]:
    """Return valid, distinct role signatures while tolerating irrelevant ones."""
    if shutil.which("openssl") is None:
        fail(path, "openssl is required to verify TUF signatures")
    signatures = document.get("signatures")
    if type(signatures) is not list:
        fail(f"{path}.signatures", "must be an array")
    allowed = set(role_keyids)
    payload = canonical_bytes(document.get("signed"))
    seen: set[str] = set()
    valid: set[str] = set()
    for index, value in enumerate(signatures):
        signature = require_keys(value, f"{path}.signatures[{index}]", ("keyid", "sig"))
        keyid = require_tuf_keyid(signature["keyid"], f"{path}.signatures[{index}].keyid")
        if keyid in seen:
            fail(f"{path}.signatures[{index}].keyid", "duplicate TUF signature key ID")
        seen.add(keyid)
        sig_hex = require_string(signature["sig"], f"{path}.signatures[{index}].sig")
        if not re.fullmatch(r"[0-9a-f]{128}", sig_hex):
            fail(f"{path}.signatures[{index}].sig", "must be a lowercase Ed25519 signature in hex")
        if keyid not in allowed:
            continue
        try:
            verify_ed25519(
                payload,
                bytes.fromhex(sig_hex),
                keys[keyid],
                f"{path}.signatures[{index}]",
            )
        except ReleaseValidationError as error:
            if str(error).endswith("Ed25519 signature verification failed"):
                continue
            raise
        valid.add(keyid)
    return valid


def verify_tuf_role(
    document: dict[str, Any],
    role_keyids: Iterable[str],
    threshold: int,
    keys: dict[str, bytes],
    path: str,
) -> set[str]:
    valid = valid_tuf_signature_keyids(document, role_keyids, keys, path)
    if len(valid) < threshold:
        fail(path, f"requires {threshold} distinct valid TUF role signatures; received {len(valid)}")
    return valid


def parse_tuf_root(document: dict[str, Any], path: str) -> dict[str, Any]:
    signed, _signatures = parse_tuf_signed_document(document, path, "root")
    keys = parse_tuf_keys(signed.get("keys"), f"{path}.signed.keys")
    roles = require_object(signed.get("roles"), f"{path}.signed.roles")
    required_roles = ("root", "timestamp", "snapshot", "targets")
    if set(roles) - set(required_roles) - {"mirrors"}:
        fail(f"{path}.signed.roles", "contains an unsupported top-level role")
    parsed_roles: dict[str, tuple[tuple[str, ...], int]] = {}
    for role_name in required_roles:
        if role_name not in roles:
            fail(f"{path}.signed.roles", f"missing required role {role_name!r}")
        parsed_roles[role_name] = parse_tuf_role(roles[role_name], f"{path}.signed.roles.{role_name}", keys)
    if "mirrors" in roles:
        parsed_roles["mirrors"] = parse_tuf_role(roles["mirrors"], f"{path}.signed.roles.mirrors", keys)
    return {
        "document": document,
        "signed": signed,
        "keys": keys,
        "roles": parsed_roles,
        "version": signed["version"],
    }


def load_tuf_root_chain(metadata_dir: Path, trusted_root_path: str) -> dict[str, Any]:
    """Advance from an immutable trusted root through contiguous root updates.

    A public key by itself cannot safely describe the root threshold or all
    delegated roles.  The root anchor is therefore a protected, out-of-band
    TUF root metadata file.  Each subsequent root requires both the previous
    root threshold and the new root threshold, as required for safe rotation.
    """
    trusted_root_file = Path(trusted_root_path)
    trusted_raw, trusted_document = read_tuf_metadata_file(trusted_root_file.parent, trusted_root_file.name)
    trusted = parse_tuf_root(trusted_document, f"TUF trusted root {trusted_root_file.name}")
    trusted_keyids, trusted_threshold = trusted["roles"]["root"]
    verify_tuf_role(
        trusted_document,
        trusted_keyids,
        trusted_threshold,
        trusted["keys"],
        f"TUF trusted root {trusted_root_file.name}",
    )

    numbered: list[tuple[int, str]] = []
    try:
        entries = list(metadata_dir.iterdir())
    except OSError as error:
        fail("TUF metadata", f"cannot enumerate root metadata: {error}")
    for entry in entries:
        match = TUF_ROOT_FILE_RE.fullmatch(entry.name)
        if match:
            numbered.append((int(match.group(1)), entry.name))
    numbered.sort()
    expected_version = trusted["version"] + 1
    previous = trusted
    current = trusted
    for filename_version, filename in numbered:
        raw, document = read_tuf_metadata_file(metadata_dir, filename)
        if filename_version < trusted["version"]:
            fail("TUF root metadata", f"contains a root older than the trusted anchor: {filename}")
        if filename_version == trusted["version"]:
            if raw != trusted_raw:
                fail("TUF root metadata", f"{filename} conflicts with the trusted root version")
            continue
        if filename_version != expected_version:
            fail("TUF root metadata", f"missing root version {expected_version} before {filename}")
        root = parse_tuf_root(document, f"TUF {filename}")
        if root["version"] != filename_version:
            fail(f"TUF {filename}.signed.version", "must equal its consistent-snapshot filename version")
        root_keyids, root_threshold = root["roles"]["root"]
        verify_tuf_role(document, root_keyids, root_threshold, root["keys"], f"TUF {filename}")
        previous_keyids, previous_threshold = previous["roles"]["root"]
        verify_tuf_role(
            document,
            previous_keyids,
            previous_threshold,
            previous["keys"],
            f"TUF {filename} previous-root authorization",
        )
        previous = root
        current = root
        expected_version += 1
    return current


def require_tuf_metadata_directory(path_text: str) -> Path:
    path = Path(path_text)
    if path.is_symlink() or not path.is_dir():
        fail("TUF metadata", f"must be a real directory: {path}")
    return path


def read_tuf_state(state_dir_text: str | None) -> dict[str, int]:
    """Read prior trusted metadata versions without creating or changing state."""
    if not state_dir_text:
        return {}
    state_dir = Path(state_dir_text)
    if not state_dir.exists():
        return {}
    if state_dir.is_symlink() or not state_dir.is_dir():
        fail("TUF state", f"must be a real directory: {state_dir}")
    state_file = state_dir / TUF_STATE_FILENAME
    if not state_file.exists():
        return {}
    state = read_json_document(str(state_file), "trusted TUF state")
    root = require_keys(state, "$.tufState", ("schema", "metadataVersions"), ("metadataDigests",))
    if root["schema"] != "kerosene.tuf-trusted-state/v1":
        fail("$.tufState.schema", "must equal 'kerosene.tuf-trusted-state/v1'")
    versions = require_object(root["metadataVersions"], "$.tufState.metadataVersions")
    parsed: dict[str, int] = {}
    for role, version in versions.items():
        if not TUF_ROLE_NAME_RE.fullmatch(role) and role not in {"root", "timestamp", "snapshot", "targets"}:
            fail("$.tufState.metadataVersions", "contains an invalid role name")
        parsed[role] = require_integer(version, f"$.tufState.metadataVersions.{role}", 1)
    return parsed


def guard_tuf_equivocation(state_dir_text: str | None, versions: dict[str, int], digests: dict[str, str]) -> None:
    if not state_dir_text:
        return
    path = Path(state_dir_text) / TUF_STATE_FILENAME
    if not path.exists():
        return
    previous = read_json_document(str(path), "trusted TUF state")
    old_versions = read_tuf_state(state_dir_text)
    old_digests = require_object(previous.get("metadataDigests", {}), "TUF metadata digests")
    for role, digest in old_digests.items():
        require_digest(digest, f"TUF metadata digests.{role}")
        if versions.get(role) == old_versions.get(role) and digests.get(role) != digest:
            fail(f"TUF metadata {role}", "same-version equivocation against persistent trusted metadata")


def guard_tuf_versions(versions: dict[str, int], trusted_versions: dict[str, int]) -> None:
    for role, trusted_version in trusted_versions.items():
        candidate = versions.get(role)
        if candidate is not None and candidate < trusted_version:
            fail(
                f"TUF metadata {role}",
                f"version {candidate} is older than persistently trusted version {trusted_version}",
            )


def persist_tuf_state(state_dir_text: str, tuf_result: dict[str, Any]) -> str:
    """Persist only verified TUF versions before rollout; no keys or secrets."""
    versions = tuf_result.get("metadataVersions")
    if type(versions) is not dict:
        raise ApplyBlockedError("verified TUF result does not contain metadata versions")
    parsed_versions = {
        require_string(role, "TUF metadata role"): require_integer(version, f"TUF metadata {role}", 1)
        for role, version in versions.items()
    }
    state_dir = prepare_state_dir(state_dir_text)
    old_versions = read_tuf_state(str(state_dir))
    guard_tuf_versions(parsed_versions, old_versions)
    digests = require_object(tuf_result.get("metadataDigests", {}), "verified TUF metadata digests")
    guard_tuf_equivocation(str(state_dir), parsed_versions, digests)
    old_file = state_dir / TUF_STATE_FILENAME
    old_digests = read_json_document(str(old_file), "trusted TUF state").get("metadataDigests", {}) if old_file.exists() else {}
    destination = state_dir / TUF_STATE_FILENAME
    atomic_write_json(
        str(destination),
        {
            "schema": "kerosene.tuf-trusted-state/v1",
            "metadataVersions": {**old_versions, **parsed_versions},
            "metadataDigests": {**old_digests, **digests},
        },
        mode=0o600,
    )
    return str(destination)


def parse_tuf_meta_reference(value: Any, path: str) -> dict[str, Any]:
    reference = require_keys(value, path, ("version", "length", "hashes"))
    version = require_integer(reference["version"], f"{path}.version", 1)
    length = require_integer(reference["length"], f"{path}.length", 0)
    hashes = require_object(reference["hashes"], f"{path}.hashes")
    sha256 = require_string(hashes.get("sha256"), f"{path}.hashes.sha256")
    if not re.fullmatch(r"[0-9a-f]{64}", sha256):
        fail(f"{path}.hashes.sha256", "must be a lowercase SHA-256 hex digest")
    return {"version": version, "length": length, "sha256": sha256}


def verify_tuf_meta_reference(
    parent_signed: dict[str, Any],
    child_filename: str,
    child_bytes: bytes,
    child_signed: dict[str, Any],
    path: str,
) -> None:
    meta = require_object(parent_signed.get("meta"), f"{path}.meta")
    if child_filename not in meta:
        fail(f"{path}.meta", f"does not authenticate {child_filename}")
    reference = parse_tuf_meta_reference(meta[child_filename], f"{path}.meta.{child_filename}")
    if len(child_bytes) != reference["length"]:
        fail(f"{path}.meta.{child_filename}.length", "does not match the supplied metadata bytes")
    if hashlib.sha256(child_bytes).hexdigest() != reference["sha256"]:
        fail(f"{path}.meta.{child_filename}.hashes.sha256", "does not match the supplied metadata bytes")
    if child_signed["version"] != reference["version"]:
        fail(f"{path}.meta.{child_filename}.version", "does not match the supplied metadata version")


def parse_tuf_targets(document: dict[str, Any], path: str) -> dict[str, Any]:
    signed, _signatures = parse_tuf_signed_document(document, path, "targets")
    targets = require_object(signed.get("targets"), f"{path}.signed.targets")
    return {"document": document, "signed": signed, "targets": targets, "version": signed["version"]}


def tuf_target_path_matches(pattern: str, target_path: str) -> bool:
    """Apply TUF path globs without allowing '*' to cross a slash."""
    pattern_parts = pattern.split("/")
    target_parts = target_path.split("/")
    if len(pattern_parts) != len(target_parts):
        return False
    for pattern_part, target_part in zip(pattern_parts, target_parts):
        expression = ""
        index = 0
        while index < len(pattern_part):
            character = pattern_part[index]
            if character == "*":
                expression += "[^/]*"
            elif character == "?":
                expression += "[^/]"
            elif character == "[":
                closing = pattern_part.find("]", index + 1)
                if closing == -1:
                    expression += re.escape(character)
                else:
                    expression += pattern_part[index : closing + 1]
                    index = closing
            else:
                expression += re.escape(character)
            index += 1
        if not re.fullmatch(expression, target_part):
            return False
    return True


def parse_tuf_delegations(signed: dict[str, Any], path: str) -> list[dict[str, Any]]:
    if "delegations" not in signed:
        return []
    delegations = require_keys(signed["delegations"], f"{path}.delegations", ("keys", "roles"))
    keys = parse_tuf_keys(delegations["keys"], f"{path}.delegations.keys")
    roles = delegations["roles"]
    if type(roles) is not list:
        fail(f"{path}.delegations.roles", "must be an array")
    parsed: list[dict[str, Any]] = []
    seen: set[str] = set()
    for index, value in enumerate(roles):
        role_path = f"{path}.delegations.roles[{index}]"
        role = require_object(value, role_path)
        required = {"name", "keyids", "threshold", "terminating"}
        patterns = {"paths", "path_hash_prefixes"}
        unsupported = set(role) - required - patterns
        missing = required - set(role)
        supplied_patterns = patterns & set(role)
        if missing:
            fail(role_path, f"missing required field(s): {', '.join(sorted(missing))}")
        if unsupported:
            fail(role_path, f"unsupported field(s): {', '.join(sorted(unsupported))}")
        if len(supplied_patterns) != 1:
            fail(role_path, "must declare exactly one of paths or path_hash_prefixes")
        name = require_string(role["name"], f"{role_path}.name")
        if not TUF_ROLE_NAME_RE.fullmatch(name):
            fail(f"{role_path}.name", "must be a simple lowercase role filename")
        if name in seen:
            fail(f"{role_path}.name", "duplicate delegated role")
        seen.add(name)
        keyids, threshold = parse_tuf_role(
            {"keyids": role["keyids"], "threshold": role["threshold"]},
            role_path,
            keys,
        )
        terminating = require_boolean(role["terminating"], f"{role_path}.terminating")
        entry: dict[str, Any] = {
            "name": name,
            "keyids": keyids,
            "threshold": threshold,
            "keys": keys,
            "terminating": terminating,
        }
        if "paths" in role:
            if type(role["paths"]) is not list or not role["paths"]:
                fail(f"{role_path}.paths", "must be a non-empty array")
            entry["paths"] = [require_string(item, f"{role_path}.paths[{position}]") for position, item in enumerate(role["paths"])]
        else:
            if type(role["path_hash_prefixes"]) is not list or not role["path_hash_prefixes"]:
                fail(f"{role_path}.path_hash_prefixes", "must be a non-empty array")
            prefixes: list[str] = []
            for position, item in enumerate(role["path_hash_prefixes"]):
                prefix = require_string(item, f"{role_path}.path_hash_prefixes[{position}]")
                if not re.fullmatch(r"[0-9a-f]{1,64}", prefix):
                    fail(f"{role_path}.path_hash_prefixes[{position}]", "must be a lowercase SHA-256 prefix")
                prefixes.append(prefix)
            entry["path_hash_prefixes"] = prefixes
        parsed.append(entry)
    return parsed


def delegation_matches_target(delegation: dict[str, Any], target_path: str) -> bool:
    if "paths" in delegation:
        return any(tuf_target_path_matches(pattern, target_path) for pattern in delegation["paths"])
    target_hash = hashlib.sha256(target_path.encode("utf-8")).hexdigest()
    return any(target_hash.startswith(prefix) for prefix in delegation["path_hash_prefixes"])


def verify_tuf_target_binding(
    target_info: Any,
    target_path: str,
    role: dict[str, Any],
    release: dict[str, Any],
    release_bytes: bytes,
    summary: dict[str, Any],
    path: str,
) -> None:
    target = require_keys(target_info, path, ("length", "hashes", "custom"))
    target_length = require_integer(target["length"], f"{path}.length", 0)
    hashes = require_object(target["hashes"], f"{path}.hashes")
    sha256 = require_string(hashes.get("sha256"), f"{path}.hashes.sha256")
    if not re.fullmatch(r"[0-9a-f]{64}", sha256):
        fail(f"{path}.hashes.sha256", "must be a lowercase SHA-256 hex digest")
    if len(release_bytes) != target_length:
        fail(f"{path}.length", "does not match the supplied release-lock bytes")
    if hashlib.sha256(release_bytes).hexdigest() != sha256:
        fail(f"{path}.hashes.sha256", "does not match the supplied release-lock bytes")
    custom = require_object(target["custom"], f"{path}.custom")
    if custom.get("keroseneReleaseLockCanonicalDigest") != canonical_digest(release):
        fail(
            f"{path}.custom.keroseneReleaseLockCanonicalDigest",
            "does not bind this TUF target to the supplied release lock",
        )
    if target_path != summary["tuf"]["targetPath"]:
        fail(path, "does not match the release TUF target path")


def resolve_tuf_target(
    metadata_dir: Path,
    snapshot_signed: dict[str, Any],
    role: dict[str, Any],
    role_keyids: Iterable[str],
    role_threshold: int,
    role_keys: dict[str, bytes],
    target_path: str,
    release: dict[str, Any],
    release_bytes: bytes,
    summary: dict[str, Any],
    versions: dict[str, int],
    visited: set[str],
    depth: int = 0,
    digests: dict[str, str] | None = None,
) -> str | None:
    if depth > MAX_TUF_DELEGATION_DEPTH:
        fail("TUF delegations", f"exceed the maximum depth of {MAX_TUF_DELEGATION_DEPTH}")
    verify_tuf_role(role["document"], role_keyids, role_threshold, role_keys, "TUF targets role")
    if digests is not None:
        # Pin precisely the document just verified, not a later path reread.
        digests[role["name"]] = canonical_digest(role["signed"])
    if target_path in role["targets"]:
        verify_tuf_target_binding(
            role["targets"][target_path], target_path, role, release, release_bytes, summary, "TUF target"
        )
        return role["name"]
    for delegation in parse_tuf_delegations(role["signed"], "TUF targets role.signed"):
        if not delegation_matches_target(delegation, target_path):
            continue
        filename = f"{delegation['name']}.json"
        if filename in visited:
            fail("TUF delegations", f"cycle detected through {filename}")
        child_raw, child_document = read_tuf_metadata_file(metadata_dir, filename)
        child = parse_tuf_targets(child_document, f"TUF {filename}")
        verify_tuf_meta_reference(snapshot_signed, filename, child_raw, child["signed"], "TUF snapshot")
        child["name"] = delegation["name"]
        versions[delegation["name"]] = child["version"]
        found = resolve_tuf_target(
            metadata_dir,
            snapshot_signed,
            child,
            delegation["keyids"],
            delegation["threshold"],
            delegation["keys"],
            target_path,
            release,
            release_bytes,
            summary,
            versions,
            visited | {filename},
            depth + 1,
            digests,
        )
        if found is not None:
            return found
        if delegation["terminating"]:
            return None
    return None


def verify_tuf_metadata_bundle(
    release: dict[str, Any],
    release_bytes: bytes,
    summary: dict[str, Any],
    metadata_dir_path: str,
    trusted_root_path: str,
    tuf_state_dir: str | None = None,
) -> dict[str, Any]:
    """Verify an offline TUF 1.x root → timestamp → snapshot → targets chain.

    The bundle uses canonical JSON and standard TUF Ed25519 key/sig encodings.
    TUF target custom metadata binds the detached target entry to the exact
    release-lock canonical digest, avoiding an impossible self-hash inside the
    release lock itself.
    """
    metadata_dir = require_tuf_metadata_directory(metadata_dir_path)
    root = load_tuf_root_chain(metadata_dir, trusted_root_path)

    timestamp_raw, timestamp_document = read_tuf_metadata_file(metadata_dir, "timestamp.json")
    timestamp_signed, _timestamp_signatures = parse_tuf_signed_document(
        timestamp_document, "TUF timestamp.json", "timestamp"
    )
    timestamp_keyids, timestamp_threshold = root["roles"]["timestamp"]
    verify_tuf_role(timestamp_document, timestamp_keyids, timestamp_threshold, root["keys"], "TUF timestamp.json")

    snapshot_raw, snapshot_document = read_tuf_metadata_file(metadata_dir, "snapshot.json")
    snapshot_signed, _snapshot_signatures = parse_tuf_signed_document(
        snapshot_document, "TUF snapshot.json", "snapshot"
    )
    verify_tuf_meta_reference(timestamp_signed, "snapshot.json", snapshot_raw, snapshot_signed, "TUF timestamp.json")
    snapshot_keyids, snapshot_threshold = root["roles"]["snapshot"]
    verify_tuf_role(snapshot_document, snapshot_keyids, snapshot_threshold, root["keys"], "TUF snapshot.json")

    targets_raw, targets_document = read_tuf_metadata_file(metadata_dir, "targets.json")
    targets = parse_tuf_targets(targets_document, "TUF targets.json")
    verify_tuf_meta_reference(snapshot_signed, "targets.json", targets_raw, targets["signed"], "TUF snapshot.json")
    targets["name"] = "targets"
    targets_keyids, targets_threshold = root["roles"]["targets"]
    versions = {
        "root": root["version"],
        "timestamp": timestamp_signed["version"],
        "snapshot": snapshot_signed["version"],
        "targets": targets["version"],
    }
    digests = {"root": canonical_digest(root["signed"]), "timestamp": canonical_digest(timestamp_signed), "snapshot": canonical_digest(snapshot_signed)}
    target_role = resolve_tuf_target(
        metadata_dir,
        snapshot_signed,
        targets,
        targets_keyids,
        targets_threshold,
        root["keys"],
        summary["tuf"]["targetPath"],
        release,
        release_bytes,
        summary,
        versions,
        {"targets.json"},
        digests=digests,
    )
    if target_role is None:
        fail("TUF targets", f"does not authorize {summary['tuf']['targetPath']}")
    guard_tuf_versions(versions, read_tuf_state(tuf_state_dir))
    guard_tuf_equivocation(tuf_state_dir, versions, digests)
    return {
        "schema": "tuf-1.x-metadata-bundle",
        "mode": "full",
        "signatureVerified": True,
        "targetRole": target_role,
        "metadataVersions": versions,
        "metadataDigests": digests,
    }


def decode_base64(value: Any, path: str) -> bytes:
    text = require_string(value, path)
    try:
        return base64.b64decode(text, validate=True)
    except (ValueError, binascii.Error) as error:
        fail(path, f"invalid base64: {error}")


def verify_ed25519(payload: bytes, signature: bytes, public_key_der: bytes, path: str) -> None:
    if shutil.which("openssl") is None:
        fail(path, "openssl is required to verify release signatures")
    with tempfile.TemporaryDirectory(prefix="kerosene-stack-verify-") as directory:
        root = Path(directory)
        payload_path = root / "payload"
        signature_path = root / "signature"
        public_key_path = root / "public.der"
        payload_path.write_bytes(payload)
        signature_path.write_bytes(signature)
        public_key_path.write_bytes(public_key_der)
        result = subprocess.run(
            [
                "openssl",
                "pkeyutl",
                "-verify",
                "-rawin",
                "-pubin",
                "-inkey",
                str(public_key_path),
                "-keyform",
                "DER",
                "-sigfile",
                str(signature_path),
                "-in",
                str(payload_path),
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    if result.returncode != 0:
        fail(path, "Ed25519 signature verification failed")


def validate_roster(path_text: str, summary: dict[str, Any]) -> dict[str, bytes]:
    roster = read_json_document(path_text, "validator roster")
    root = require_keys(roster, "$.roster", ("schema", "networkId", "members"))
    if root["schema"] != ROSTER_SCHEMA:
        fail("$.roster.schema", f"must equal {ROSTER_SCHEMA!r}")
    if root["networkId"] != summary["bft"]["networkId"]:
        fail("$.roster.networkId", "does not match the release BFT network")
    members = require_object(root["members"], "$.roster.members")
    if len(members) != summary["bft"]["members"]:
        fail("$.roster.members", "member count does not match the release BFT membership")
    decoded: dict[str, bytes] = {}
    for member_id, public_key in members.items():
        require_identifier(member_id, "$.roster.members.<member>")
        decoded[member_id] = decode_base64(public_key, f"$.roster.members.{member_id}")
    return decoded


def verify_signature_set(
    payload: bytes,
    signatures: Any,
    roster: dict[str, bytes],
    threshold: int,
    path: str,
    allowed_members: set[str] | None = None,
) -> int:
    if type(signatures) is not list:
        fail(path, "signatures must be an array")
    seen: set[str] = set()
    for index, value in enumerate(signatures):
        signature = require_keys(
            value,
            f"{path}[{index}]",
            ("memberId", "publicKeyDerBase64", "signatureBase64"),
        )
        member_id = require_identifier(signature["memberId"], f"{path}[{index}].memberId")
        if member_id in seen:
            fail(f"{path}[{index}].memberId", "duplicate signer")
        if member_id not in roster:
            fail(f"{path}[{index}].memberId", "signer is not in the trusted roster")
        if allowed_members is not None and member_id not in allowed_members:
            fail(f"{path}[{index}].memberId", "signer is not an accepted Bank observer")
        seen.add(member_id)
        public_key = decode_base64(signature["publicKeyDerBase64"], f"{path}[{index}].publicKeyDerBase64")
        if public_key != roster[member_id]:
            fail(f"{path}[{index}].publicKeyDerBase64", "does not match the trusted roster")
        signature_bytes = decode_base64(signature["signatureBase64"], f"{path}[{index}].signatureBase64")
        verify_ed25519(payload, signature_bytes, public_key, f"{path}[{index}]")
    if len(seen) < threshold:
        fail(path, f"requires {threshold} distinct valid signatures; received {len(seen)}")
    return len(seen)


def verify_bft_receipt(
    release: dict[str, Any],
    summary: dict[str, Any],
    receipt_path: str,
    roster_path: str,
) -> dict[str, Any]:
    if summary["releaseSchemaVersion"] == 3:
        raise ApplyBlockedError("v3 requires a real ordered consensus proof, not a detached signature receipt")
    receipt = read_json_document(receipt_path, "BFT release receipt")
    root = require_keys(
        receipt,
        "$.receipt",
        ("schema", "releaseLockCanonicalDigest", "networkId", "height", "threshold", "members", "signatures"),
    )
    if root["schema"] != RELEASE_RECEIPT_SCHEMA:
        fail("$.receipt.schema", f"must equal {RELEASE_RECEIPT_SCHEMA!r}")
    if root["releaseLockCanonicalDigest"] != canonical_digest(release):
        fail("$.receipt.releaseLockCanonicalDigest", "does not identify the supplied release lock")
    for field in ("networkId", "height", "threshold", "members"):
        if root[field] != summary["bft"][field]:
            fail(f"$.receipt.{field}", "does not match the release lock")
    payload = dict(receipt)
    signatures = payload.pop("signatures")
    roster = validate_roster(roster_path, summary)
    count = verify_signature_set(
        canonical_bytes(payload),
        signatures,
        roster,
        summary["bft"]["threshold"],
        "$.receipt.signatures",
    )
    return {"schema": RELEASE_RECEIPT_SCHEMA, "signaturesVerified": count}


def verify_consensus_authorization(release: dict[str, Any], summary: dict[str, Any], args: argparse.Namespace) -> dict[str, Any]:
    if summary["releaseSchemaVersion"] < 3:
        return verify_bft_receipt(release, summary, args.bft_receipt, args.validator_roster)
    if not args.cell_dir or not args.consensus_proof:
        raise ApplyBlockedError("v3 consensus verification requires --cell-dir with protected anchor/verifier and --consensus-proof")
    config = lifecycle.load_config(sys.modules[__name__], args.cell_dir)
    lifecycle.verify_bootstrap_trust(sys.modules[__name__], args.cell_dir, config)
    anchor = read_json_document(str(Path(args.cell_dir) / "consensus-anchor.json"), "protected consensus anchor", 8 * 1024 * 1024)
    policy = require_object(anchor.get("policy"), "consensus anchor policy")
    if any(policy.get(key) != summary["bft"][key] for key in ("networkId", "epoch", "threshold")) or len(require_object(policy.get("members"), "governance policy members")) != summary["bft"]["members"]:
        raise ApplyBlockedError("release consensus policy differs from the independently trusted anchor")
    roster = validate_roster(args.validator_roster, summary)
    if set(policy["members"]) != set(roster):
        raise ApplyBlockedError("consensus proposal authorizers differ from trusted release roster")
    for member_id, public_key in policy["members"].items():
        if TUF_ED25519_SPKI_PREFIX + decode_base64(public_key, "governance proposal public key") != roster[member_id]:
            raise ApplyBlockedError("consensus proposal authorizer key differs from trusted release roster")
    result = lifecycle.verify_consensus(sys.modules[__name__], args.cell_dir, config, args.consensus_proof, canonical_digest(release), summary)
    return result


def verify_tuf_proof(
    release: dict[str, Any],
    summary: dict[str, Any],
    proof_path: str,
    root_key_path: str,
) -> dict[str, Any]:
    proof = read_json_document(proof_path, "TUF target proof")
    root = require_keys(
        proof,
        "$.tufProof",
        ("schema", "targetPath", "metadataVersion", "targetDigest", "expiresAt", "signatureBase64"),
    )
    if root["schema"] != TUF_PROOF_SCHEMA:
        fail("$.tufProof.schema", f"must equal {TUF_PROOF_SCHEMA!r}")
    for field in ("targetPath", "metadataVersion", "targetDigest"):
        if root[field] != summary["tuf"][field]:
            fail(f"$.tufProof.{field}", "does not match the release TUF target")
    if root["expiresAt"] != summary["tuf"]["expiresAt"]:
        fail("$.tufProof.expiresAt", "does not match the release TUF authorization expiry")
    parse_timestamp(root["expiresAt"], "$.tufProof.expiresAt")
    try:
        root_key_b64 = Path(root_key_path).read_text(encoding="utf-8").strip()
    except OSError as error:
        fail("TUF root key", f"cannot read: {error}")
    public_key = decode_base64(root_key_b64, "TUF root key")
    signature = decode_base64(root["signatureBase64"], "$.tufProof.signatureBase64")
    payload = dict(proof)
    payload.pop("signatureBase64")
    verify_ed25519(canonical_bytes(payload), signature, public_key, "$.tufProof.signatureBase64")
    return {"schema": TUF_PROOF_SCHEMA, "mode": "legacy-proof", "signatureVerified": True}


def verify_tuf_authorization(
    release: dict[str, Any],
    release_bytes: bytes,
    summary: dict[str, Any],
    args: argparse.Namespace,
    *,
    require_full: bool,
) -> dict[str, Any]:
    """Select one TUF evidence mode and make legacy proof non-authoritative.

    A signed target proof was useful while the project did not ship an offline
    TUF bundle, but it cannot protect a rollout against mix-and-match or root
    rotation failures.  It remains available only for backwards-compatible
    structural inspection.  All update decisions and applies require the full
    root/timestamp/snapshot/targets chain.
    """
    full_requested = bool(args.tuf_metadata_dir)
    legacy_requested = bool(args.tuf_proof)
    if full_requested and legacy_requested:
        fail("TUF authorization", "--tuf-metadata-dir and --tuf-proof are mutually exclusive")
    if full_requested:
        if summary["releaseSchemaVersion"] not in (2, 3):
            fail(
                "TUF authorization",
                "full TUF metadata requires a kerosene.release-lock/v2 or v3 document; v1 has a circular target digest",
            )
        if args.tuf_root_key:
            fail("TUF authorization", "--tuf-root-key is only valid with legacy --tuf-proof")
        if not args.tuf_trusted_root:
            fail("TUF authorization", "--tuf-trusted-root is required with --tuf-metadata-dir")
        if require_full and not args.tuf_state_dir:
            fail("TUF authorization", "--tuf-state-dir is required for rollback-safe update decisions")
        return verify_tuf_metadata_bundle(
            release,
            release_bytes,
            summary,
            args.tuf_metadata_dir,
            args.tuf_trusted_root,
            args.tuf_state_dir,
        )
    if legacy_requested:
        if summary["releaseSchemaVersion"] != 1:
            fail("TUF authorization", "legacy --tuf-proof is supported only for kerosene.release-lock/v1")
        if not args.tuf_root_key:
            fail("TUF authorization", "--tuf-root-key is required with --tuf-proof")
        if require_full:
            fail(
                "TUF authorization",
                "a legacy --tuf-proof cannot authorize check-update or update --apply; supply --tuf-metadata-dir",
            )
        return verify_tuf_proof(release, summary, args.tuf_proof, args.tuf_root_key)
    if require_full:
        fail(
            "TUF authorization",
            "--tuf-metadata-dir, --tuf-trusted-root, and --tuf-state-dir are required",
        )
    if args.tuf_root_key:
        fail("TUF authorization", "--tuf-root-key requires TUF metadata or a legacy proof")
    if args.tuf_trusted_root:
        fail("TUF authorization", "--tuf-trusted-root requires --tuf-metadata-dir")
    fail("TUF authorization", "no TUF evidence was supplied")


def verify_bank_observer_report(
    release: dict[str, Any],
    summary: dict[str, Any],
    report_path: str,
    roster_path: str,
) -> dict[str, Any]:
    report = read_json_document(report_path, "Bank observer report")
    root = require_keys(
        report,
        "$.observerReport",
        (
            "schema",
            "releaseId",
            "networkId",
            "targetSequence",
            "releaseLockCanonicalDigest",
            "issuedAt",
            "expiresAt",
            "observations",
            "signatures",
        ),
    )
    if root["schema"] != OBSERVER_REPORT_SCHEMA:
        fail("$.observerReport.schema", f"must equal {OBSERVER_REPORT_SCHEMA!r}")
    if root["releaseId"] != summary["releaseId"]:
        fail("$.observerReport.releaseId", "does not match the release lock")
    if root["networkId"] != summary["networkId"]:
        fail("$.observerReport.networkId", "does not match the release network")
    if require_integer(root["targetSequence"], "$.observerReport.targetSequence", 1) != summary["sequence"]:
        fail("$.observerReport.targetSequence", "does not match the release sequence")
    if root["releaseLockCanonicalDigest"] != canonical_digest(release):
        fail("$.observerReport.releaseLockCanonicalDigest", "does not identify the supplied release lock")
    issued_at = parse_rfc3339(root["issuedAt"], "$.observerReport.issuedAt")
    expires_at = parse_rfc3339(root["expiresAt"], "$.observerReport.expiresAt")
    now = dt.datetime.now(dt.timezone.utc)
    if issued_at > now + MAX_CLOCK_SKEW:
        fail("$.observerReport.issuedAt", "cannot be more than five minutes in the future")
    if expires_at <= now:
        fail("$.observerReport.expiresAt", "is expired")
    if expires_at <= issued_at:
        fail("$.observerReport.expiresAt", "must be after issuedAt")
    if expires_at - issued_at > MAX_BANK_REPORT_LIFETIME:
        fail("$.observerReport.expiresAt", "may be at most one hour after issuedAt")
    observations = root["observations"]
    if type(observations) is not list:
        fail("$.observerReport.observations", "must be an array")
    compatible_ids: set[str] = set()
    for index, value in enumerate(observations):
        observation = require_keys(
            value,
            f"$.observerReport.observations[{index}]",
            ("observerId", "status", "observedSequence", "releaseDigest", "observedAt"),
        )
        observer_id = require_identifier(observation["observerId"], f"$.observerReport.observations[{index}].observerId")
        if any(
            type(existing) is dict and existing.get("observerId") == observer_id
            for existing in observations[:index]
        ):
            fail(f"$.observerReport.observations[{index}].observerId", "duplicate observer")
        observed_at = parse_rfc3339(observation["observedAt"], f"$.observerReport.observations[{index}].observedAt")
        if observed_at > issued_at + MAX_CLOCK_SKEW:
            fail(f"$.observerReport.observations[{index}].observedAt", "cannot be later than the report issue time")
        if observed_at < issued_at - MAX_BANK_OBSERVATION_AGE:
            fail(
                f"$.observerReport.observations[{index}].observedAt",
                "must be no more than fifteen minutes older than the report issue time",
            )
        if observation["status"] != "compatible":
            continue
        if require_integer(
            observation["observedSequence"],
            f"$.observerReport.observations[{index}].observedSequence",
            0,
        ) != summary["sequence"]:
            fail(f"$.observerReport.observations[{index}].observedSequence", "does not match the target sequence")
        if observation["releaseDigest"] != canonical_digest(release):
            fail(f"$.observerReport.observations[{index}].releaseDigest", "does not identify the release lock")
        compatible_ids.add(observer_id)
    minimum = summary["policy"]["minimumBankObservers"]
    if len(compatible_ids) < minimum:
        fail("$.observerReport.observations", f"requires {minimum} compatible observers; received {len(compatible_ids)}")
    payload = dict(report)
    signatures = payload.pop("signatures")
    roster = validate_roster(roster_path, summary)
    count = verify_signature_set(
        canonical_bytes(payload),
        signatures,
        roster,
        minimum,
        "$.observerReport.signatures",
        allowed_members=compatible_ids,
    )
    return {
        "schema": OBSERVER_REPORT_SCHEMA,
        "compatibleObservers": len(compatible_ids),
        "signaturesVerified": count,
        "issuedAt": root["issuedAt"],
        "expiresAt": root["expiresAt"],
    }


def validate_snapshot_attestation_request(
    release: dict[str, Any],
    summary: dict[str, Any],
    request_path: str,
    environment: str,
) -> dict[str, Any]:
    """Validate the unsigned Kubernetes collection before trusting its receipt.

    The request itself carries no authority: it merely makes the full PVC
    scope, VolumeSnapshot identities and deterministic set digest visible to
    the independently trusted snapshot attester.  The attester's signature is
    required separately and cryptographically binds this exact request.
    """
    request = read_json_document(request_path, "snapshot attestation request")
    root = require_keys(
        request,
        "$.snapshotRequest",
        (
            "schema",
            "kind",
            "environment",
            "release",
            "requestedAt",
            "selection",
            "snapshotSetDigest",
            "snapshots",
            "attestation",
        ),
    )
    if root["schema"] != SNAPSHOT_ATTESTATION_REQUEST_SCHEMA:
        fail("$.snapshotRequest.schema", f"must equal {SNAPSHOT_ATTESTATION_REQUEST_SCHEMA!r}")
    if root["kind"] != "VolumeSnapshotAttestationRequest":
        fail("$.snapshotRequest.kind", "must equal 'VolumeSnapshotAttestationRequest'")
    if root["environment"] != environment:
        fail("$.snapshotRequest.environment", "does not match the selected environment")
    release_ref = require_keys(root["release"], "$.snapshotRequest.release", ("id", "lockDigest"))
    if release_ref["id"] != summary["releaseId"]:
        fail("$.snapshotRequest.release.id", "does not match the release lock")
    if release_ref["lockDigest"] != canonical_digest(release):
        fail("$.snapshotRequest.release.lockDigest", "does not identify the supplied release lock")
    requested_at = parse_rfc3339(root["requestedAt"], "$.snapshotRequest.requestedAt")
    if requested_at > dt.datetime.now(dt.timezone.utc) + dt.timedelta(minutes=5):
        fail("$.snapshotRequest.requestedAt", "cannot be in the future")
    selection = require_keys(root["selection"], "$.snapshotRequest.selection", ("labelSelector", "namespaces"))
    if selection["labelSelector"] is not None:
        require_string(selection["labelSelector"], "$.snapshotRequest.selection.labelSelector")
    if selection["namespaces"] != ["kerosene-staging", "kerosene-staging-vault"]:
        fail("$.snapshotRequest.selection.namespaces", "must cover the two canonical staging Cell namespaces")
    attestation = require_keys(
        root["attestation"],
        "$.snapshotRequest.attestation",
        ("externalSignerRequired", "status"),
    )
    if attestation["externalSignerRequired"] is not True or attestation["status"] != "unsigned-request":
        fail("$.snapshotRequest.attestation", "must be an unsigned external-attester request")
    snapshot_set_digest = require_digest(root["snapshotSetDigest"], "$.snapshotRequest.snapshotSetDigest")
    snapshots = root["snapshots"]
    if type(snapshots) is not list:
        fail("$.snapshotRequest.snapshots", "must be an array")
    if len(snapshots) != len(SNAPSHOT_PVC_TARGETS):
        fail("$.snapshotRequest.snapshots", f"must contain exactly {len(SNAPSHOT_PVC_TARGETS)} Cell PVC snapshots")

    seen_targets: set[tuple[str, str]] = set()
    seen_uids: set[str] = set()
    seen_contents: set[str] = set()
    normalized: list[dict[str, Any]] = []
    for index, value in enumerate(snapshots):
        path = f"$.snapshotRequest.snapshots[{index}]"
        snapshot = require_keys(
            value,
            path,
            (
                "boundVolumeSnapshotContentName",
                "creationTimestamp",
                "namespace",
                "persistentVolumeClaim",
                "readyToUse",
                "restoreSize",
                "volumeSnapshotClassName",
                "volumeSnapshotName",
                "volumeSnapshotUid",
            ),
        )
        namespace = require_string(snapshot["namespace"], f"{path}.namespace")
        pvc = require_string(snapshot["persistentVolumeClaim"], f"{path}.persistentVolumeClaim")
        target = (namespace, pvc)
        if target not in SNAPSHOT_PVC_TARGETS:
            fail(path, f"contains an unexpected PVC target {namespace}/{pvc}")
        if target in seen_targets:
            fail(path, f"duplicates the PVC target {namespace}/{pvc}")
        seen_targets.add(target)
        if snapshot["readyToUse"] is not True:
            fail(f"{path}.readyToUse", "must be true")
        content = require_string(snapshot["boundVolumeSnapshotContentName"], f"{path}.boundVolumeSnapshotContentName")
        uid = require_string(snapshot["volumeSnapshotUid"], f"{path}.volumeSnapshotUid")
        if uid in seen_uids:
            fail(f"{path}.volumeSnapshotUid", "must be unique within the snapshot set")
        if content in seen_contents:
            fail(f"{path}.boundVolumeSnapshotContentName", "must be unique within the snapshot set")
        seen_uids.add(uid)
        seen_contents.add(content)
        require_string(snapshot["volumeSnapshotName"], f"{path}.volumeSnapshotName")
        parse_rfc3339(snapshot["creationTimestamp"], f"{path}.creationTimestamp")
        for nullable_field in ("restoreSize", "volumeSnapshotClassName"):
            if snapshot[nullable_field] is not None:
                require_string(snapshot[nullable_field], f"{path}.{nullable_field}")
        normalized.append(snapshot)
    if seen_targets != set(SNAPSHOT_PVC_TARGETS):
        missing = sorted(set(SNAPSHOT_PVC_TARGETS) - seen_targets)
        fail("$.snapshotRequest.snapshots", f"is missing required PVC snapshot(s): {missing}")
    normalized.sort(
        key=lambda item: (
            item["namespace"],
            item["persistentVolumeClaim"],
            item["volumeSnapshotName"],
            item["volumeSnapshotUid"],
        )
    )
    if snapshots != normalized:
        fail("$.snapshotRequest.snapshots", "must be deterministically sorted")
    if canonical_digest(normalized) != snapshot_set_digest:
        fail("$.snapshotRequest.snapshotSetDigest", "does not match the canonical snapshot set")
    return {
        "attestationRequestDigest": canonical_digest(request),
        "snapshotSetDigest": snapshot_set_digest,
        "requestedAt": root["requestedAt"],
    }


def validate_snapshot_receipt(
    release: dict[str, Any],
    summary: dict[str, Any],
    receipt_path: str,
    request_path: str,
    environment: str,
    provider_key_path: str,
) -> dict[str, Any]:
    request = validate_snapshot_attestation_request(release, summary, request_path, environment)
    receipt = read_json_document(receipt_path, "snapshot receipt")
    root = require_keys(
        receipt,
        "$.snapshot",
        (
            "schema",
            "releaseId",
            "environment",
            "status",
            "snapshotId",
            "provider",
            "snapshotSetDigest",
            "attestationRequestDigest",
            "restoreTested",
            "restoreVerifiedAt",
            "createdAt",
            "expiresAt",
            "providerPublicKeyDerBase64",
            "signatureBase64",
        ),
    )
    if root["schema"] != SNAPSHOT_RECEIPT_SCHEMA:
        fail("$.snapshot.schema", f"must equal {SNAPSHOT_RECEIPT_SCHEMA!r}")
    if root["releaseId"] != summary["releaseId"]:
        fail("$.snapshot.releaseId", "does not match the release lock")
    if root["environment"] != environment:
        fail("$.snapshot.environment", "does not match the selected environment")
    if root["status"] != "verified":
        fail("$.snapshot.status", "must equal 'verified'")
    require_identifier(root["snapshotId"], "$.snapshot.snapshotId")
    require_identifier(root["provider"], "$.snapshot.provider")
    if root["snapshotSetDigest"] != request["snapshotSetDigest"]:
        fail("$.snapshot.snapshotSetDigest", "does not match the collected VolumeSnapshot set")
    if root["attestationRequestDigest"] != request["attestationRequestDigest"]:
        fail("$.snapshot.attestationRequestDigest", "does not bind the supplied attestation request")
    if root["restoreTested"] is not True:
        fail("$.snapshot.restoreTested", "must be true after an independently verified restore test")
    restore_verified_at = parse_rfc3339(root["restoreVerifiedAt"], "$.snapshot.restoreVerifiedAt")
    created_at = parse_rfc3339(root["createdAt"], "$.snapshot.createdAt")
    expires_at = parse_rfc3339(root["expiresAt"], "$.snapshot.expiresAt")
    now = dt.datetime.now(dt.timezone.utc)
    if created_at > now + dt.timedelta(minutes=5) or restore_verified_at > now + dt.timedelta(minutes=5):
        fail("$.snapshot", "receipt timestamps cannot be in the future")
    if expires_at <= now:
        fail("$.snapshot.expiresAt", "is expired")
    if expires_at <= created_at or expires_at <= restore_verified_at:
        fail("$.snapshot.expiresAt", "must be after creation and restore verification")
    try:
        trusted_key_b64 = Path(provider_key_path).read_text(encoding="utf-8").strip()
    except OSError as error:
        fail("snapshot provider key", f"cannot read: {error}")
    trusted_key = decode_base64(trusted_key_b64, "snapshot provider key")
    provider_key = decode_base64(
        root["providerPublicKeyDerBase64"],
        "$.snapshot.providerPublicKeyDerBase64",
    )
    if provider_key != trusted_key:
        fail("$.snapshot.providerPublicKeyDerBase64", "does not match the trusted snapshot provider key")
    signature = decode_base64(root["signatureBase64"], "$.snapshot.signatureBase64")
    payload = dict(receipt)
    payload.pop("signatureBase64")
    verify_ed25519(canonical_bytes(payload), signature, trusted_key, "$.snapshot.signatureBase64")
    return {
        "snapshotId": root["snapshotId"],
        "provider": root["provider"],
        "snapshotSetDigest": root["snapshotSetDigest"],
        "attestationRequestDigest": root["attestationRequestDigest"],
        "restoreTested": True,
        "signatureVerified": True,
    }


def build_plan(release: dict[str, Any], summary: dict[str, Any]) -> dict[str, Any]:
    return {
        "schema": STACK_PLAN_SCHEMA,
        "releaseId": summary["releaseId"],
        "sequence": summary["sequence"],
        "networkId": summary["networkId"],
        "releaseLockCanonicalDigest": canonical_digest(release),
        "sourceBundle": summary["sourceBundle"],
        "mode": "plan-only",
        "applyEnabled": False,
        "applyBlockedBy": [
            "Apply requires a verified BFT release receipt, Bank-observer report, and snapshot receipt.",
            "The operator must explicitly select staging-cell and confirm the exact release ID.",
        ],
        "guardrails": [
            "Never build from source during update.",
            "Never use a mutable image tag.",
            "Never activate a Vault signer from deployment automation.",
