def atomic_write_json(path_text: str, value: dict[str, Any], *, mode: int = 0o644) -> None:
    destination = Path(path_text)
    parent = destination.parent
    if not parent.is_dir():
        raise ReleaseValidationError(f"{destination}: output directory does not exist")
    temporary_name: str | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=parent,
            prefix=f".{destination.name}.",
            delete=False,
        ) as handle:
            temporary_name = handle.name
            os.fchmod(handle.fileno(), mode)
            json.dump(value, handle, ensure_ascii=False, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary_name, destination)
        parent_descriptor = os.open(parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(parent_descriptor)
        finally:
            os.close(parent_descriptor)
        temporary_name = None
    finally:
        if temporary_name:
            Path(temporary_name).unlink(missing_ok=True)


def emit_verification(summary: dict[str, Any], as_json: bool, authorization: dict[str, Any] | None = None) -> None:
    result = {
        "schema": "kerosene.stack.release-structure-check/v1",
        "releaseId": summary["releaseId"],
        "networkId": summary["networkId"],
        "sequence": summary["sequence"],
        "requiredComponents": list(SERVICE_REPOSITORY),
        "structuralValidation": "passed",
        "cryptographicAuthorization": "verified" if authorization else "not-checked",
        "productionRolloutAuthorized": False,
    }
    if authorization:
        result["authorization"] = authorization
    if as_json:
        print(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True))
        return
    print(f"Release lock structurally valid: {summary['releaseId']} (sequence {summary['sequence']}).")
    if authorization:
        print("Cryptographic authorization verified; the public adapter still cannot authorize a production rollout.")
    else:
        print("Cryptographic authorization was not requested; this result cannot authorize a production rollout.")


def emit_plan(plan: dict[str, Any], as_json: bool) -> None:
    if as_json:
        print(json.dumps(plan, ensure_ascii=False, indent=2, sort_keys=True))
        return
    print(f"Safe update plan generated for {plan['releaseId']} (sequence {plan['sequence']}).")
    print("Apply requires full TUF/BFT/Bank evidence, an attestation request plus restore-tested snapshot receipt, and explicit operator confirmation.")
    print("Phases: " + ", ".join(phase["id"] for phase in plan["phases"]))


def prepare_state_dir(state_dir_text: str) -> Path:
    state_dir = Path(state_dir_text)
    state_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    if state_dir.is_symlink() or not state_dir.is_dir():
        raise OSError(f"state directory must be a real directory: {state_dir}")
    os.chmod(state_dir, 0o700)
    return state_dir


def write_update_state(state_dir_text: str, state: dict[str, Any]) -> str:
    state_dir = prepare_state_dir(state_dir_text)
    state_file = state_dir / "update-state.json"
    atomic_write_json(str(state_file), state, mode=0o600)
    return str(state_file)


def read_existing_update_state(state_dir_text: str) -> dict[str, Any] | None:
    state_file = Path(state_dir_text) / "update-state.json"
    if not state_file.exists():
        return None
    return read_json_document(str(state_file), "existing update state")


def acquire_update_lock(state_dir_text: str, summary: dict[str, Any]) -> tuple[int, Path]:
    state_dir = prepare_state_dir(state_dir_text)
    lock_file = state_dir / UPDATE_LOCK_FILENAME
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    try:
        descriptor = os.open(lock_file, flags, 0o600)
    except FileExistsError as error:
        raise ApplyBlockedError(
            f"another update is active or requires manual investigation: {lock_file}"
        ) from error
    try:
        record = {
            "schema": "kerosene.stack.update-lock/v1",
            "releaseId": summary["releaseId"],
            "sequence": summary["sequence"],
            "pid": os.getpid(),
            "startedAt": dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z"),
        }
        os.write(descriptor, canonical_bytes(record) + b"\n")
        os.fsync(descriptor)
    except BaseException:
        os.close(descriptor)
        lock_file.unlink(missing_ok=True)
        raise
    return descriptor, lock_file


def release_update_lock(descriptor: int, lock_file: Path) -> None:
    held = os.fstat(descriptor)
    os.close(descriptor)
    try:
        current = os.stat(lock_file, follow_symlinks=False)
    except FileNotFoundError:
        return
    if (current.st_dev, current.st_ino) != (held.st_dev, held.st_ino):
        raise OSError(f"update lock changed while held and was not removed: {lock_file}")
    lock_file.unlink()


def guard_previous_update_state(state_dir_text: str, summary: dict[str, Any], environment: str, resume_update_id: str | None = None, change_id: str | None = None) -> None:
    previous = read_existing_update_state(state_dir_text)
    if previous is None:
        return
    if previous.get("schema") != "kerosene.stack.update-state/v1":
        raise ApplyBlockedError("existing update-state.json has an unsupported schema")
    previous_environment = require_string(previous.get("environment"), "$.environment")
    if previous_environment != environment:
        raise ApplyBlockedError("existing update-state.json belongs to another environment")
    previous_sequence = require_integer(previous.get("sequence"), "$.sequence", 1)
    previous_status = require_string(previous.get("status"), "$.status")
    if previous.get("manualRecoveryRequired") is True or previous_status == "failed":
        if resume_update_id and resume_update_id == previous.get("updateId") == summary.get("_canonicalDigest") and previous_sequence == summary["sequence"] and change_id == previous.get("changeId"):
            return
        raise ApplyBlockedError("existing update-state.json requires explicit same-target recovery with --resume-update-id and original changeId")
    if previous_status not in ("committed", "dry-run-passed"):
        if resume_update_id and resume_update_id == previous.get("updateId") == summary.get("_canonicalDigest") and previous_sequence == summary["sequence"] and change_id == previous.get("changeId"):
            return
        raise ApplyBlockedError("existing update-state.json records an incomplete update; recovery must revalidate all gates")
    if previous_status == "committed" and previous_sequence >= summary["sequence"]:
        raise ApplyBlockedError(
            f"release sequence {summary['sequence']} is not newer than the committed sequence {previous_sequence}"
        )


def run_staging_cell_deploy(summary: dict[str, Any], args: argparse.Namespace) -> None:
    if args.environment != "staging-cell":
        raise ApplyBlockedError(
            "only --environment staging-cell is implemented; production requires the private ops adapter"
        )
    if args.deployment_manifest:
        artifact = lifecycle.verify_deployment(sys.modules[__name__], args._release, summary, args.deployment_manifest)
        lifecycle.execute(sys.modules[__name__], artifact, summary, args, args._checkpoint)
        return
    if not args.dry_run:
        raise ApplyBlockedError("real apply requires --deployment-manifest with approved configuration digests; legacy adapter is dry-run only")
    repo_root = Path(__file__).resolve().parents[1]
    deploy_script = repo_root / "infra/kubernetes/scripts/deploy.sh"
    if not deploy_script.is_file():
        raise ApplyBlockedError(f"missing deploy adapter: {deploy_script}")
    environment = os.environ.copy()
    for unsafe in ("KEROSENE_SKIP_STAGING_SMOKES", "KEROSENE_FORCE_CONFLICTS", "KEROSENE_ENSURE_MONITORING"):
        if environment.get(unsafe, "0") != "0":
            raise ApplyBlockedError(f"verified updates forbid inherited {unsafe}")
        environment.pop(unsafe, None)
    for component, variable in DEPLOY_IMAGE_ENV.items():
        environment[variable] = summary["services"][component]["image"]
    targets = ("staging-vault", "staging")
    for target in targets:
        command = ["bash", str(deploy_script), target]
        if args.dry_run:
            command.append("--dry-run")
        print(f"[*] Applying release {summary['releaseId']} to {target}...", file=sys.stderr)
        result = subprocess.run(command, env=environment, check=False, stdout=sys.stderr)
        if result.returncode != 0:
            raise ApplyBlockedError(f"deploy adapter failed for {target} with exit code {result.returncode}")


def apply_locked_release(release: dict[str, Any], summary: dict[str, Any], args: argparse.Namespace) -> int:
    required_paths = {
        "--consensus-proof" if summary["releaseSchemaVersion"] == 3 else "--bft-receipt": args.consensus_proof if summary["releaseSchemaVersion"] == 3 else args.bft_receipt,
        "--validator-roster": args.validator_roster,
        "--bank-observer-report": args.bank_observer_report,
        "--snapshot-attestation-request": args.snapshot_attestation_request,
        "--snapshot-receipt": args.snapshot_receipt,
        "--snapshot-provider-key": args.snapshot_provider_key,
    }
    missing = [name for name, path in required_paths.items() if not path]
    if missing:
        print(f"update blocked: missing required evidence: {', '.join(missing)}", file=sys.stderr)
        return EXIT_CANNOT_APPLY

    try:
        summary["_canonicalDigest"] = canonical_digest(release)
        # The public command's early check is helpful feedback, but only this
        # check under update.lock prevents concurrent installs from both seeing
        # a missing journal before one of them commits the Cell.
        if args.command == "install" and read_existing_update_state(args.state_dir) is not None:
            raise ApplyBlockedError("install refuses an existing deployment journal under the Cell update lock")
        guard_previous_update_state(args.state_dir, summary, args.environment, args.resume_update_id, args.change_id)
        if args.deployment_manifest:
            lifecycle.verify_deployment(sys.modules[__name__], release, summary, args.deployment_manifest)
        elif not args.dry_run:
            raise ApplyBlockedError("--deployment-manifest is required before any state-changing deployment")
        if not args.dry_run and summary["releaseSchemaVersion"] < 3:
            raise ApplyBlockedError("real apply requires v3 ordered consensus authorization; v1/v2 detached signatures are dry-run only")
        if not args.dry_run:
            lifecycle.require_execution_capabilities(sys.modules[__name__])
        tuf_result = verify_tuf_authorization(release, summary["_releaseBytes"], summary, args, require_full=True)
        receipt_result = verify_consensus_authorization(release, summary, args)
        if not args.dry_run:
            lifecycle.verify_maintenance(sys.modules[__name__], args)
            lifecycle.verify_recovery_plan(sys.modules[__name__], release, summary, args)
        observer_result = verify_bank_observer_report(
            release,
            summary,
            args.bank_observer_report,
            args.validator_roster,
        )
        snapshot_result = validate_snapshot_receipt(
            release,
            summary,
            args.snapshot_receipt,
            args.snapshot_attestation_request,
            args.environment,
            args.snapshot_provider_key,
        )
        tuf_state_file = persist_tuf_state(args.tuf_state_dir, tuf_result)
    except (ReleaseValidationError, OSError) as error:
        print(f"update blocked: {error}", file=sys.stderr)
        return EXIT_CANNOT_APPLY

    update_id = canonical_digest(release)
    state: dict[str, Any] = {
        "schema": "kerosene.stack.update-state/v1",
        "updateId": update_id,
        "releaseId": summary["releaseId"],
        "sequence": summary["sequence"],
        "environment": args.environment,
        "changeId": args.change_id,
        "operatorId": args.operator_id,
        "status": "verified",
        "phase": "verified",
        "evidence": {
            "tuf": tuf_result,
            "bft": receipt_result,
            "bankObservers": observer_result,
            "snapshot": snapshot_result,
        },
        "startedAt": dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z"),
    }
    state_file = write_update_state(args.state_dir, state)
    args._release = release
    def checkpoint(phase: str, evidence: dict[str, Any]) -> None:
        state["phase"] = phase
        event = {"phase": phase, "observedAt": dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z"), "evidence": evidence}
        state.setdefault("events", []).append(event)
        write_update_state(args.state_dir, state)
        history = prepare_state_dir(str(Path(args.state_dir) / "history"))
        audit_file = history / (str(summary["sequence"]) + "-" + dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%S%fZ") + ".json")
        atomic_write_json(str(audit_file), state, mode=0o600)
    args._checkpoint = checkpoint

    try:
        checkpoint("snapshot-accepted", {})
        checkpoint("rollout-started", {})
        run_staging_cell_deploy(summary, args)
        state["phase"] = "validate-and-commit"
        state["status"] = "committed" if not args.dry_run else "dry-run-passed"
        state["completedAt"] = dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")
        checkpoint("validate-and-commit", {})
    except (ReleaseValidationError, OSError, RuntimeError, subprocess.TimeoutExpired) as error:
        state["phase"] = "failed"
        state["status"] = "failed"
        state["failure"] = str(error)
        state["manualRecoveryRequired"] = True
        checkpoint("failed", {})
        print(f"update failed after state was recorded: {error}", file=sys.stderr)
        return EXIT_CANNOT_APPLY

    result = {
        "schema": "kerosene.stack.update-result/v1",
        "status": state["status"],
        "releaseId": summary["releaseId"],
        "environment": args.environment,
        "updateId": update_id,
        "stateFile": state_file,
        "tufStateFile": tuf_state_file,
        "tufSignatureVerified": tuf_result["signatureVerified"],
        "bftSignaturesVerified": receipt_result["signaturesVerified"],
        "bankObserversVerified": observer_result["compatibleObservers"],
        "snapshotId": snapshot_result["snapshotId"],
        "snapshotSetDigest": snapshot_result["snapshotSetDigest"],
    }
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        print(f"Kerosene Cell update {state['status']}: {summary['releaseId']} ({args.environment}).")
        print(f"State recorded at {state_file}.")
    return 0


def apply_release(release: dict[str, Any], summary: dict[str, Any], args: argparse.Namespace) -> int:
    if args.confirm_release != summary["releaseId"]:
        print("update blocked: --confirm-release must exactly match the release ID", file=sys.stderr)
        return EXIT_CANNOT_APPLY
    if args.environment != "staging-cell":
        print("update blocked: only --environment staging-cell is implemented in the public adapter", file=sys.stderr)
        return EXIT_CANNOT_APPLY
    if not args.state_dir:
        print("update blocked: --state-dir is required for an applied update", file=sys.stderr)
        return EXIT_CANNOT_APPLY
    if not args.tuf_state_dir:
        print("update blocked: --tuf-state-dir is required for an applied update", file=sys.stderr)
        return EXIT_CANNOT_APPLY
    try:
        if args.cell_dir:
            lifecycle.require_cell_state_directory(sys.modules[__name__], args.cell_dir, args.state_dir)
        state_dir = prepare_state_dir(args.state_dir)
        tuf_state_dir = prepare_state_dir(args.tuf_state_dir)
        if not os.path.samefile(state_dir, tuf_state_dir):
            raise ApplyBlockedError(
                "--tuf-state-dir must identify the same protected directory as --state-dir so update.lock serializes trust-state writes"
            )
        descriptor, lock_file = acquire_update_lock(args.state_dir, summary)
    except (ApplyBlockedError, OSError) as error:
        print(f"update blocked: {error}", file=sys.stderr)
        return EXIT_CANNOT_APPLY

    result = EXIT_CANNOT_APPLY
    try:
        result = apply_locked_release(release, summary, args)
    finally:
        try:
            release_update_lock(descriptor, lock_file)
        except OSError as error:
            print(f"update lock requires manual investigation: {error}", file=sys.stderr)
            result = EXIT_CANNOT_APPLY
    return result


def load_and_validate(path: str) -> tuple[dict[str, Any], dict[str, Any]]:
    release, release_bytes = read_release(path)
    summary = validate_release(release)
    summary["_releaseBytes"] = release_bytes
    return release, summary


def command_verify(args: argparse.Namespace) -> int:
    release, summary = load_and_validate(args.release)
    tuf_requested = bool(
        args.tuf_proof
        or args.tuf_metadata_dir
        or args.tuf_trusted_root
        or args.tuf_root_key
        or args.tuf_state_dir
    )
    other_evidence_paths = (args.consensus_proof if summary["releaseSchemaVersion"] == 3 else args.bft_receipt, args.validator_roster, args.bank_observer_report)
    if tuf_requested != any(other_evidence_paths) or (any(other_evidence_paths) and not all(other_evidence_paths)):
        raise ReleaseValidationError("verify-release requires BFT receipt, validator roster, and Bank observer report together")
    authorization = None
    if tuf_requested:
        authorization = {
            "tuf": verify_tuf_authorization(release, summary["_releaseBytes"], summary, args, require_full=False),
            "bft": verify_consensus_authorization(release, summary, args),
            "bankObservers": verify_bank_observer_report(
                release,
                summary,
                args.bank_observer_report,
                args.validator_roster,
            ),
        }
    emit_verification(summary, args.json, authorization)
    return 0


def command_plan(args: argparse.Namespace) -> int:
    release, summary = load_and_validate(args.release)
    plan = build_plan(release, summary)
    if args.output:
        atomic_write_json(args.output, plan)
    emit_plan(plan, args.json)
    return 0


def command_update(args: argparse.Namespace) -> int:
    if args.cell_dir:
        config = lifecycle.load_config(sys.modules[__name__], args.cell_dir)
        lifecycle.verify_bootstrap_trust(sys.modules[__name__], args.cell_dir, config)
        args.state_dir = args.state_dir or str(Path(args.cell_dir) / "state")
        args.tuf_state_dir = args.tuf_state_dir or args.state_dir
        args.tuf_trusted_root = args.tuf_trusted_root or str(Path(args.cell_dir) / "tuf-root.json")
        args.validator_roster = args.validator_roster or str(Path(args.cell_dir) / "validator-roster.json")
        args.snapshot_provider_key = args.snapshot_provider_key or str(Path(args.cell_dir) / "snapshot-provider.pub")
    if args.bundle_dir:
        bundle = Path(args.bundle_dir)
        args.release = args.release or str(bundle / "release-lock.json")
        args.deployment_manifest = args.deployment_manifest or str(bundle / "deployment.json")
        args.tuf_metadata_dir = args.tuf_metadata_dir or str(bundle / "metadata")
        args.bft_receipt = args.bft_receipt or str(bundle / "release-receipt.json")
        args.bank_observer_report = args.bank_observer_report or str(bundle / "bank-observer-report.json")
        args.snapshot_attestation_request = args.snapshot_attestation_request or str(bundle / "snapshot-attestation-request.json")
        args.snapshot_receipt = args.snapshot_receipt or str(bundle / "snapshot-receipt.json")
        args.consensus_proof = args.consensus_proof or str(bundle / "consensus-proof.json")
    if not args.release:
        raise ReleaseValidationError("--release or --bundle-dir is required")
    if args.command == "install":
        if not args.cell_dir:
            raise ReleaseValidationError("install requires --cell-dir initialized with explicit public trust anchors")
        if read_existing_update_state(args.state_dir) is not None:
            raise ApplyBlockedError("install refuses an existing deployment journal; use update or explicit recovery")
    release, summary = load_and_validate(args.release)
    if not args.apply:
        plan = build_plan(release, summary)
        if args.output:
            atomic_write_json(args.output, plan)
        emit_plan(plan, args.json)
        return 0
    return apply_release(release, summary, args)


def command_check_update(args: argparse.Namespace) -> int:
    release, summary = load_and_validate(args.release)
    required_paths = {
        "--consensus-proof" if summary["releaseSchemaVersion"] == 3 else "--bft-receipt": args.consensus_proof if summary["releaseSchemaVersion"] == 3 else args.bft_receipt,
        "--validator-roster": args.validator_roster,
        "--bank-observer-report": args.bank_observer_report,
    }
    missing = [name for name, path in required_paths.items() if not path]
    if missing:
        print(f"check-update blocked: missing required evidence: {', '.join(missing)}", file=sys.stderr)
        return EXIT_CANNOT_APPLY

    try:
        tuf_result = verify_tuf_authorization(release, summary["_releaseBytes"], summary, args, require_full=True)
        receipt_result = verify_consensus_authorization(release, summary, args)
        observer_result = verify_bank_observer_report(
            release,
            summary,
            args.bank_observer_report,
            args.validator_roster,
        )
        previous = read_existing_update_state(args.state_dir) if args.state_dir else None
    except ReleaseValidationError as error:
        print(f"check-update blocked: {error}", file=sys.stderr)
        return EXIT_CANNOT_APPLY

    current_sequence: int | None = None
    previous_status: str | None = None
    manual_recovery_required = False
    if previous is not None:
        if previous.get("schema") != "kerosene.stack.update-state/v1":
            print("check-update blocked: existing update-state.json has an unsupported schema", file=sys.stderr)
            return EXIT_CANNOT_APPLY
        if previous.get("environment") != args.environment:
            print("check-update blocked: existing update-state.json belongs to another environment", file=sys.stderr)
            return EXIT_CANNOT_APPLY
        previous_status = require_string(previous.get("status"), "$.status")
        previous_sequence = require_integer(previous.get("sequence"), "$.sequence", 1)
        manual_recovery_required = previous_status not in ("committed", "dry-run-passed") or previous.get("manualRecoveryRequired") is True
        if previous_status == "committed":
            current_sequence = previous_sequence
            if current_sequence == summary["sequence"] and previous.get("updateId") != canonical_digest(release):
                print("check-update blocked: same sequence is bound to different committed release bytes", file=sys.stderr)
                return EXIT_CANNOT_APPLY

    update_required = current_sequence is None or summary["sequence"] > current_sequence
    if manual_recovery_required:
        next_action = "manual-recovery-required"
    elif update_required:
        next_action = "review-update-plan-execution-not-qualified" if lifecycle.EXECUTION_BLOCKERS or summary["releaseSchemaVersion"] < 3 else "kerosene-stack update --apply"
    else:
        next_action = "no-action"
    result = {
        "schema": "kerosene.stack.update-check/v1",
        "releaseId": summary["releaseId"],
        "environment": args.environment,
        "targetSequence": summary["sequence"],
        "currentSequence": current_sequence,
        "updateRequired": update_required,
        "manualRecoveryRequired": manual_recovery_required,
        "nextAction": next_action,
        "bankObserversVerified": observer_result["compatibleObservers"],
        "tufSignatureVerified": tuf_result["signatureVerified"],
        "tufMetadataVersions": tuf_result.get("metadataVersions"),
        "bftSignaturesVerified": receipt_result["signaturesVerified"],
        "orderedConsensusVerified": receipt_result.get("consensusVerified", False),
        "applyQualified": not lifecycle.EXECUTION_BLOCKERS and summary["releaseSchemaVersion"] == 3,
        "executionBlockers": list(lifecycle.EXECUTION_BLOCKERS) + (["legacy-detached-receipt-not-ordered-consensus"] if summary["releaseSchemaVersion"] < 3 else []),
    }
    if previous_status is not None:
        result["previousStatus"] = previous_status
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        if manual_recovery_required:
            print(f"Update blocked: manual recovery is required before {summary['releaseId']}.")
        elif update_required:
            current = "none" if current_sequence is None else str(current_sequence)
            print(f"Update available: verified Bank evidence for sequence {summary['sequence']} (current: {current}); review execution qualification before applying.")
        else:
            print(f"No update required: current sequence {current_sequence} satisfies {summary['sequence']}.")
        print(f"Verified Bank observers: {observer_result['compatibleObservers']}; next action: {next_action}.")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="kerosene-stack",
        description="Validate a complete Kerosene Cell release lock and create a safe update plan.",
    )
    subcommands = parser.add_subparsers(dest="command", required=True)

    verify = subcommands.add_parser("verify-release", help="validate structure and immutable release references")
    verify.add_argument("--release", required=True, help="path to a release-lock JSON document")
    verify.add_argument("--tuf-proof", help="legacy signed target proof JSON; cannot authorize an apply")
    verify.add_argument("--tuf-metadata-dir", help="offline TUF 1.x metadata bundle directory")
    verify.add_argument("--tuf-trusted-root", help="protected out-of-band TUF root metadata file for an offline metadata bundle")
    verify.add_argument("--tuf-root-key", help="legacy proof verifier Ed25519 public key in base64 DER form")
    verify.add_argument("--tuf-state-dir", help="optional read-only directory holding trusted TUF metadata versions")
    verify.add_argument("--bft-receipt", help="signed BFT release receipt JSON")
    verify.add_argument("--validator-roster", help="trusted validator roster JSON")
    verify.add_argument("--bank-observer-report", help="signed Bank observer compatibility report JSON")
    verify.add_argument("--cell-dir", help="protected bootstrap consensus anchor and verifier")
    verify.add_argument("--consensus-proof", help="v3 real CometBFT ordered approval and application-state proof")
    verify.add_argument("--json", action="store_true", help="emit machine-readable output")
    verify.set_defaults(handler=command_verify)

    plan = subcommands.add_parser("plan", help="produce a no-change Cell update plan")
    plan.add_argument("--release", required=True, help="path to a release-lock JSON document")
    plan.add_argument("--output", help="optional path for an atomically written JSON plan")
    plan.add_argument("--json", action="store_true", help="emit machine-readable output")
    plan.set_defaults(handler=command_plan)

    update = subcommands.add_parser("update", aliases=("install", "recover"), help="produce a plan or apply a verified staging-cell release")
    update.add_argument("--release", help="path to a release-lock JSON document")
    update.add_argument("--cell-dir", help="protected Cell directory created by init; supplies public anchors and state defaults")
    update.add_argument("--bundle-dir", help="prepared offline release data directory; never executes contained source code")
    update.add_argument("--output", help="optional path for an atomically written JSON plan")
    update.add_argument("--json", action="store_true", help="emit machine-readable output")
    update.add_argument("--apply", action="store_true", help="execute the staging-cell rollout after all evidence gates pass")
    update.add_argument(
        "--environment",
        choices=("staging-cell",),
        default=os.environ.get("KEROSENE_STACK_ENVIRONMENT", "staging-cell"),
        help="deployment target; the public adapter is the two-plane staging cell",
    )
    update.add_argument("--confirm-release", help="exact release ID confirmation required with --apply")
    update.add_argument("--tuf-proof", help="legacy signed target proof JSON; cannot authorize --apply")
    update.add_argument("--tuf-metadata-dir", help="offline TUF 1.x metadata bundle directory required with --apply")
    update.add_argument("--tuf-trusted-root", help="protected out-of-band TUF root metadata file required with --apply")
    update.add_argument("--tuf-root-key", help="legacy proof verifier Ed25519 public key in base64 DER form")
    update.add_argument("--tuf-state-dir", help="persistent trusted-TUF state directory required with --apply")
    update.add_argument("--bft-receipt", help="signed BFT release receipt JSON")
    update.add_argument("--validator-roster", help="trusted validator roster JSON")
    update.add_argument("--bank-observer-report", help="signed Bank observer compatibility report JSON")
    update.add_argument(
        "--snapshot-attestation-request",
        help="unsigned, fail-closed VolumeSnapshot collection request bound to this release",
    )
    update.add_argument("--snapshot-receipt", help="signed restore-tested snapshot provider receipt JSON")
    update.add_argument(
        "--snapshot-provider-key",
        help="trusted snapshot provider Ed25519 public key in base64 DER form",
    )
    update.add_argument("--state-dir", help="directory for the atomic update state record")
    update.add_argument("--deployment-manifest", help="exact approved JSON deployment artifact; each configuration digest must match release lock")
    update.add_argument("--change-id", help="audited operator change identifier")
    update.add_argument("--operator-id", help="local operator attribution, not a substitute for API authentication")
    update.add_argument("--consensus-proof", help="v3 real CometBFT ordered approval and application-state proof")
    update.add_argument("--maintenance-endpoint", help="HTTPS KFE maintenance status endpoint, rechecked at each runtime phase")
    update.add_argument("--maintenance-ca", help="KFE TLS trust CA")
    update.add_argument("--maintenance-cert", help="operator mTLS certificate")
    update.add_argument("--maintenance-key", help="operator mTLS key reference; never stored in the journal")
    update.add_argument("--maintenance-token-file", help="protected authenticated ADMIN session token reference")
    update.add_argument("--recovery-evidence", help="quorum-approved tested recovery plan bound by migration.recoveryEvidenceDigest")
    update.add_argument("--resume-update-id", help="recover only this exact interrupted canonical release digest; never clears locks or bypasses gates")
    update.add_argument("--dry-run", action="store_true", help="run both staging overlays with server-side dry-run")
    update.set_defaults(handler=command_update)

    lifecycle.add_commands(sys.modules[__name__], subcommands)

    check = subcommands.add_parser(
        "check-update",
        help="show whether the signed Bank quorum requires an operator update",
    )
    check.add_argument("--release", required=True, help="path to a release-lock JSON document")
    check.add_argument("--environment", choices=("staging-cell",), default="staging-cell")
    check.add_argument("--tuf-proof", help="legacy signed target proof JSON; cannot authorize check-update")
    check.add_argument("--tuf-metadata-dir", help="offline TUF 1.x metadata bundle directory")
    check.add_argument("--tuf-trusted-root", help="protected out-of-band TUF root metadata file")
    check.add_argument("--tuf-root-key", help="legacy proof verifier Ed25519 public key in base64 DER form")
    check.add_argument("--tuf-state-dir", help="trusted TUF state directory; required and never modified by check-update")
    check.add_argument("--bft-receipt", help="legacy signed BFT release receipt JSON")
    check.add_argument("--consensus-proof", help="v3 real CometBFT ordered approval and application-state proof")
    check.add_argument("--cell-dir", help="protected bootstrap consensus anchor and verifier")
    check.add_argument("--validator-roster", required=True, help="trusted validator roster JSON")
    check.add_argument("--bank-observer-report", required=True, help="signed Bank observer compatibility report JSON")
    check.add_argument("--state-dir", help="optional directory containing the last update-state.json")
    check.add_argument("--json", action="store_true", help="emit machine-readable output")
    check.set_defaults(handler=command_check_update)

    version = subcommands.add_parser("version", help="print the controller revision")
    version.set_defaults(handler=lambda _args: (print("kerosene-stack v0.4.0-cell-operations"), 0)[1])
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.handler(args)
    except ReleaseValidationError as error:
        print(f"release lock rejected: {error}", file=sys.stderr)
        return EXIT_VALIDATION
    except OSError as error:
        print(f"kerosene-stack I/O error: {error}", file=sys.stderr)
        return 74


if __name__ == "__main__":
    raise SystemExit(main())
