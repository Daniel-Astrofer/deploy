def atomic_write_json(path_text: str, value: dict[str, Any]) -> None:
    destination = Path(path_text)
    parent = destination.parent
    if not parent.is_dir():
        raise ReleaseValidationError(f"{destination}: output directory does not exist")
    temporary_name: str | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=parent,
            prefix=f".{destination.name}.",
            delete=False,
        ) as handle:
            temporary_name = handle.name
            os.fchmod(handle.fileno(), 0o644)
            json.dump(value, handle, ensure_ascii=False, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary_name, destination)
        temporary_name = None
    finally:
        if temporary_name:
            Path(temporary_name).unlink(missing_ok=True)


def emit_verification(summary: dict[str, Any], as_json: bool, authorization: dict[str, Any] | None = None) -> None:
    result = {
        "schema": "kerosene.stack.release-structure-check/v1",
        "releaseId": summary["releaseId"],
        "networkId": summary["networkId"],
        "sequence": summary["sequence"],
        "requiredComponents": list(SERVICE_REPOSITORY),
        "structuralValidation": "passed",
        "cryptographicAuthorization": "verified" if authorization else "not-checked",
        "productionRolloutAuthorized": False,
    }
    if authorization:
        result["authorization"] = authorization
    if as_json:
        print(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True))
        return
    print(f"Release lock structurally valid: {summary['releaseId']} (sequence {summary['sequence']}).")
    print("Cryptographic authorization was not requested; this result cannot authorize a production rollout.")


def emit_plan(plan: dict[str, Any], as_json: bool) -> None:
    if as_json:
        print(json.dumps(plan, ensure_ascii=False, indent=2, sort_keys=True))
        return
    print(f"Safe update plan generated for {plan['releaseId']} (sequence {plan['sequence']}).")
    print("Apply requires verified BFT/Bank evidence, a snapshot receipt, and explicit operator confirmation.")
    print("Phases: " + ", ".join(phase["id"] for phase in plan["phases"]))


def write_update_state(state_dir_text: str, state: dict[str, Any]) -> str:
    state_dir = Path(state_dir_text)
    state_dir.mkdir(parents=True, exist_ok=True)
    os.chmod(state_dir, 0o700)
    state_file = state_dir / "update-state.json"
    atomic_write_json(str(state_file), state)
    return str(state_file)


def run_staging_cell_deploy(summary: dict[str, Any], args: argparse.Namespace) -> None:
    if args.environment != "staging-cell":
        raise ApplyBlockedError(
            "only --environment staging-cell is implemented; production requires the private ops adapter"
        )
    repo_root = Path(__file__).resolve().parents[1]
    deploy_script = repo_root / "infra/kubernetes/scripts/deploy.sh"
    if not deploy_script.is_file():
        raise ApplyBlockedError(f"missing deploy adapter: {deploy_script}")
    environment = os.environ.copy()
    for component, variable in DEPLOY_IMAGE_ENV.items():
        environment[variable] = summary["services"][component]["image"]
    targets = ("staging-vault", "staging")
    for target in targets:
        command = ["bash", str(deploy_script), target]
        if args.dry_run:
            command.append("--dry-run")
        print(f"[*] Applying release {summary['releaseId']} to {target}...", file=sys.stderr)
        result = subprocess.run(command, env=environment, check=False, stdout=sys.stderr)
        if result.returncode != 0:
            raise ApplyBlockedError(f"deploy adapter failed for {target} with exit code {result.returncode}")


def apply_release(release: dict[str, Any], summary: dict[str, Any], args: argparse.Namespace) -> int:
    if args.confirm_release != summary["releaseId"]:
        print("update blocked: --confirm-release must exactly match the release ID", file=sys.stderr)
        return EXIT_CANNOT_APPLY
    if args.environment != "staging-cell":
        print("update blocked: only --environment staging-cell is implemented in the public adapter", file=sys.stderr)
        return EXIT_CANNOT_APPLY
    if not args.state_dir:
        print("update blocked: --state-dir is required for an applied update", file=sys.stderr)
        return EXIT_CANNOT_APPLY
    required_paths = {
        "--tuf-proof": args.tuf_proof,
        "--tuf-root-key": args.tuf_root_key,
        "--bft-receipt": args.bft_receipt,
        "--validator-roster": args.validator_roster,
        "--bank-observer-report": args.bank_observer_report,
        "--snapshot-receipt": args.snapshot_receipt,
    }
    missing = [name for name, path in required_paths.items() if not path]
    if missing:
        print(f"update blocked: missing required evidence: {', '.join(missing)}", file=sys.stderr)
        return EXIT_CANNOT_APPLY

    try:
        tuf_result = verify_tuf_proof(release, summary, args.tuf_proof, args.tuf_root_key)
        receipt_result = verify_bft_receipt(release, summary, args.bft_receipt, args.validator_roster)
        observer_result = verify_bank_observer_report(
            release,
            summary,
            args.bank_observer_report,
            args.validator_roster,
        )
        snapshot_result = validate_snapshot_receipt(summary, args.snapshot_receipt, args.environment)
    except ReleaseValidationError as error:
        print(f"update blocked: {error}", file=sys.stderr)
        return EXIT_CANNOT_APPLY

    update_id = canonical_digest(release)
    state: dict[str, Any] = {
        "schema": "kerosene.stack.update-state/v1",
        "updateId": update_id,
        "releaseId": summary["releaseId"],
        "sequence": summary["sequence"],
        "environment": args.environment,
        "status": "verified",
        "phase": "verified",
        "evidence": {
            "tuf": tuf_result,
            "bft": receipt_result,
            "bankObservers": observer_result,
            "snapshot": snapshot_result,
        },
        "startedAt": dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z"),
    }
    state_file = write_update_state(args.state_dir, state)

    try:
        state["phase"] = "snapshot-accepted"
        write_update_state(args.state_dir, state)
        state["phase"] = "rollout-started"
        write_update_state(args.state_dir, state)
        run_staging_cell_deploy(summary, args)
        state["phase"] = "validate-and-commit"
        state["status"] = "committed" if not args.dry_run else "dry-run-passed"
        state["completedAt"] = dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")
        write_update_state(args.state_dir, state)
    except (ApplyBlockedError, OSError) as error:
        state["phase"] = "failed"
        state["status"] = "failed"
        state["failure"] = str(error)
        state["manualRecoveryRequired"] = True
        write_update_state(args.state_dir, state)
        print(f"update failed after state was recorded: {error}", file=sys.stderr)
        return EXIT_CANNOT_APPLY

    result = {
        "schema": "kerosene.stack.update-result/v1",
        "status": state["status"],
        "releaseId": summary["releaseId"],
        "environment": args.environment,
        "updateId": update_id,
        "stateFile": state_file,
        "tufSignatureVerified": tuf_result["signatureVerified"],
        "bftSignaturesVerified": receipt_result["signaturesVerified"],
        "bankObserversVerified": observer_result["compatibleObservers"],
        "snapshotId": snapshot_result["snapshotId"],
    }
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        print(f"Kerosene Cell update {state['status']}: {summary['releaseId']} ({args.environment}).")
        print(f"State recorded at {state_file}.")
    return 0


def load_and_validate(path: str) -> tuple[dict[str, Any], dict[str, Any]]:
    release = read_release(path)
    return release, validate_release(release)


def command_verify(args: argparse.Namespace) -> int:
    release, summary = load_and_validate(args.release)
    evidence_paths = (
        args.tuf_proof,
        args.tuf_root_key,
        args.bft_receipt,
        args.validator_roster,
        args.bank_observer_report,
    )
    if any(evidence_paths) and not all(evidence_paths):
        raise ReleaseValidationError("verify-release requires BFT receipt, validator roster, and Bank observer report together")
    authorization = None
    if all(evidence_paths):
        authorization = {
            "tuf": verify_tuf_proof(release, summary, args.tuf_proof, args.tuf_root_key),
            "bft": verify_bft_receipt(release, summary, args.bft_receipt, args.validator_roster),
            "bankObservers": verify_bank_observer_report(
                release,
                summary,
                args.bank_observer_report,
                args.validator_roster,
            ),
        }
    emit_verification(summary, args.json, authorization)
    return 0


def command_plan(args: argparse.Namespace) -> int:
    release, summary = load_and_validate(args.release)
    plan = build_plan(release, summary)
    if args.output:
        atomic_write_json(args.output, plan)
    emit_plan(plan, args.json)
    return 0


def command_update(args: argparse.Namespace) -> int:
    release, summary = load_and_validate(args.release)
    if not args.apply:
        plan = build_plan(release, summary)
        if args.output:
            atomic_write_json(args.output, plan)
        emit_plan(plan, args.json)
        return 0
    return apply_release(release, summary, args)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="kerosene-stack",
        description="Validate a complete Kerosene Cell release lock and create a safe update plan.",
    )
    subcommands = parser.add_subparsers(dest="command", required=True)

    verify = subcommands.add_parser("verify-release", help="validate structure and immutable release references")
    verify.add_argument("--release", required=True, help="path to a release-lock JSON document")
    verify.add_argument("--tuf-proof", help="signed TUF target proof JSON")
    verify.add_argument("--tuf-root-key", help="trusted TUF root Ed25519 public key in base64 DER form")
    verify.add_argument("--bft-receipt", help="signed BFT release receipt JSON")
    verify.add_argument("--validator-roster", help="trusted validator roster JSON")
    verify.add_argument("--bank-observer-report", help="signed Bank observer compatibility report JSON")
    verify.add_argument("--json", action="store_true", help="emit machine-readable output")
    verify.set_defaults(handler=command_verify)

    plan = subcommands.add_parser("plan", help="produce a no-change Cell update plan")
    plan.add_argument("--release", required=True, help="path to a release-lock JSON document")
    plan.add_argument("--output", help="optional path for an atomically written JSON plan")
    plan.add_argument("--json", action="store_true", help="emit machine-readable output")
    plan.set_defaults(handler=command_plan)

    update = subcommands.add_parser("update", help="produce a plan or apply a verified staging-cell release")
    update.add_argument("--release", required=True, help="path to a release-lock JSON document")
    update.add_argument("--output", help="optional path for an atomically written JSON plan")
    update.add_argument("--json", action="store_true", help="emit machine-readable output")
    update.add_argument("--apply", action="store_true", help="execute the staging-cell rollout after all evidence gates pass")
    update.add_argument(
        "--environment",
        choices=("staging-cell",),
        default=os.environ.get("KEROSENE_STACK_ENVIRONMENT", "staging-cell"),
        help="deployment target; the public adapter is the two-plane staging cell",
    )
    update.add_argument("--confirm-release", help="exact release ID confirmation required with --apply")
    update.add_argument("--tuf-proof", help="signed TUF target proof JSON")
    update.add_argument("--tuf-root-key", help="trusted TUF root Ed25519 public key in base64 DER form")
    update.add_argument("--bft-receipt", help="signed BFT release receipt JSON")
    update.add_argument("--validator-roster", help="trusted validator roster JSON")
    update.add_argument("--bank-observer-report", help="signed Bank observer compatibility report JSON")
    update.add_argument("--snapshot-receipt", help="verified snapshot provider receipt JSON")
    update.add_argument("--state-dir", help="directory for the atomic update state record")
    update.add_argument("--dry-run", action="store_true", help="run both staging overlays with server-side dry-run")
    update.set_defaults(handler=command_update)

    version = subcommands.add_parser("version", help="print the controller revision")
    version.set_defaults(handler=lambda _args: (print("kerosene-stack v0.2.0-staging-cell"), 0)[1])
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.handler(args)
    except ReleaseValidationError as error:
        print(f"release lock rejected: {error}", file=sys.stderr)
        return EXIT_VALIDATION
    except OSError as error:
        print(f"kerosene-stack I/O error: {error}", file=sys.stderr)
        return 74


if __name__ == "__main__":
    raise SystemExit(main())
