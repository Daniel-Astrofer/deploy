#!/usr/bin/env python3
"""Create immutable external Cell Secrets from protected local files."""

import argparse
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "stack"))
import archive
import secret_material

loader = importlib.machinery.SourceFileLoader("secret_material_stack", str(ROOT / "kerosene-stack"))
spec = importlib.util.spec_from_loader(loader.name, loader)
stack = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = stack
loader.exec_module(stack)

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--cell-dir", required=True, help="protected initialized Cell directory")
parser.add_argument("--deployment", required=True, help="prepared canonical deployment.json")
parser.add_argument("--material", required=True, help="owner-only kerosene.cell-secret-material/v1 JSON")
args = parser.parse_args()
try:
    result = secret_material.provision(
        stack, stack.lifecycle, args.cell_dir, args.deployment, args.material)
except (archive.ArchiveError, stack.ReleaseValidationError, stack.ApplyBlockedError,
        OSError, RuntimeError, ValueError, KeyError, TypeError) as error:
    print("Secret provisioning failed: " + str(error), file=sys.stderr)
    raise SystemExit(65)
print(json.dumps(result, indent=2, sort_keys=True))
