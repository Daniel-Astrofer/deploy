{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kerosene.invalid/schemas/vault-compatibility-roster-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "networkId", "members"],
  "properties": {
    "schema": {"const": "kerosene.vault-compatibility-roster/v1"},
    "networkId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "members": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 64,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
      "additionalProperties": {"type": "string", "pattern": "^MCowBQYDK2VwAyEA[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"}
    }
  }
}
