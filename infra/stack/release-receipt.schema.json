{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kerosene:release-receipt:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "releaseLockCanonicalDigest", "networkId", "height", "threshold", "members", "signatures"],
  "properties": {
    "schema": { "const": "kerosene.release-receipt/v1" },
    "releaseLockCanonicalDigest": { "$ref": "#/$defs/digest" },
    "networkId": { "$ref": "#/$defs/identifier" },
    "height": { "type": "integer", "minimum": 1 },
    "threshold": { "type": "integer", "minimum": 1 },
    "members": { "type": "integer", "minimum": 1 },
    "signatures": { "$ref": "#/$defs/signatures" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memberId", "publicKeyDerBase64", "signatureBase64"],
        "properties": {
          "memberId": { "$ref": "#/$defs/identifier" },
          "publicKeyDerBase64": { "type": "string", "minLength": 1 },
          "signatureBase64": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
