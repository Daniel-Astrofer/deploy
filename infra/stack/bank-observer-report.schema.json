{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kerosene:bank-observer-report:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "releaseId", "networkId", "targetSequence", "releaseLockCanonicalDigest", "observations", "signatures"],
  "properties": {
    "schema": { "const": "kerosene.bank-observer-report/v1" },
    "releaseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "networkId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "targetSequence": { "type": "integer", "minimum": 1 },
    "releaseLockCanonicalDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observerId", "status", "observedSequence", "releaseDigest"],
        "properties": {
          "observerId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
          "status": { "enum": ["compatible", "incompatible", "unknown"] },
          "observedSequence": { "type": "integer", "minimum": 0 },
          "releaseDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "signatures": { "type": "array", "minItems": 1 }
  }
}
